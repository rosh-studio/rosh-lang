# Include assets in source distribution
recursive-include assets/sprites *.png
recursive-include assets/sounds *.ogg *.wav
include assets/CREDITS.md
include assets/README.md

# Exclude library assets (not distributed)
prune assets/_library

# Include documentation
include README.md
include QUICK-START.md
include INSTALL.md
include LICENSE
include ROSH-MANUAL.rosh

# Include examples
recursive-include examples *.rosh
recursive-include stdlib *.rosh
