# Godot Hello Demo
# A simple demo showing Rosh → Godot GDScript compilation

# Create a player (green box with movement)
# Note: values are in pixels (800x600 canvas)
create object hero from player
    set x to 400
    set y to 300
    set color to green
    set speed to 5
end

# Create an enemy (red box)
create object enemy
    set x to 600
    set y to 150
    set color to red
end

# Create a collectible (yellow box)
create object coin
    set x to 200
    set y to 450
    set color to yellow
end

# Initial message
print "Godot Hello Demo - Use arrow keys to move!"
