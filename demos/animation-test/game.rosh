# Animation Test Demo
# Tests sprite sheet animation support

# Explosion - 9 frames in a 3x3 grid, all for one animation
create object explosion
    set sprite to "explosion-sheet.png"
    set x to 25%
    set y to 50%
    set sprite_columns to 3
    set sprite_rows to 3
    set animations to explode
end

# Player - 4 frames in a 4x1 grid, custom frame ranges
create object player
    set sprite to "player-sheet.png"
    set x to 75%
    set y to 50%
    set sprite_columns to 4
    set sprite_rows to 1
    set animations to idle left right damaged
    set animation idle to 0 0
    set animation left to 1 1
    set animation right to 2 2
    set animation damaged to 3 3
end
