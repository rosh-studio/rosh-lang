# Block Pusher - A Sokoban Puzzle Game
# Two levels with screen transitions

# === CONFIGURATION ===
# Grid: 8x6 tiles, 50px each
# Play area centered in 800x600 canvas

# === TITLE SCREEN ===
create object title
    set x to 50%
    set y to 25%
    set text to "Block Pusher"
    set color to "white"
    set font_size to 48
end

create object subtitle
    set x to 50%
    set y to 38%
    set text to "A Sokoban Puzzle Game"
    set color to "gray"
    set font_size to 24
end

create object instructions
    set x to 50%
    set y to 55%
    set text to "Push all boxes onto the circles"
    set color to "cyan"
    set font_size to 18
end

create object start_text
    set x to 50%
    set y to 80%
    set text to "Press SPACE to start"
    set color to "yellow"
    set font_size to 20
end

# === GAME OBJECTS (start hidden) ===
# See levels.txt for ASCII level definitions
# Grid formula: pixel_x = (grid_x * 50) + 225, pixel_y = (grid_y * 50) + 175

# Player with sprite
create object player
    set x to 275
    set y to 275
    set width to 40
    set height to 40
    set sprite to "player.png"
    set visible to false
end

# Box (repositioned each level)
create object box1
    set x to 375
    set y to 275
    set width to 40
    set height to 40
    set visible to false
end

# Goal circle (repositioned each level)
create object goal1
    set x to 475
    set y to 275
    set width to 44
    set height to 44
    set shape to "circle"
    set visible to false
end

# Wall obstacle (Level 2 only)
create object wall1
    set x to 475
    set y to 325
    set width to 40
    set height to 40
    set visible to false
end

# === UI ELEMENTS ===
create object level_text
    set x to 50%
    set y to 8%
    set text to "Level 1"
    set color to "white"
    set font_size to 24
    set visible to false
end

create object moves_text
    set x to 50%
    set y to 92%
    set text to "Moves: 0"
    set color to "gray"
    set font_size to 16
    set visible to false
end

create object win_text
    set x to 50%
    set y to 50%
    set text to "You Win!"
    set color to "gold"
    set font_size to 64
    set visible to false
end

create object next_level_text
    set x to 50%
    set y to 65%
    set text to "Press SPACE for next level"
    set color to "yellow"
    set font_size to 20
    set visible to false
end

# === GAME STATE ===
# level: 0=title, 1=playing L1, 2=playing L2, 3=victory
create object state
    set x to 0
    set y to 0
    set width to 1
    set height to 1
    set level to 0
    set moves to 0
    set can_move to 1
    set visible to false
end

# === LEVEL SETUP FUNCTIONS ===
define function start_level_1
    # Level 1: Simple horizontal push
    # Player (1,2), Box (3,2), Goal (5,2)
    set player.x to 275
    set player.y to 275
    set box1.x to 375
    set box1.y to 275
    set goal1.x to 475
    set goal1.y to 275
    set wall1.visible to false
    set level_text.text to "Level 1"
    set state.level to 1
    set state.moves to 0
    set moves_text.text to "Moves: 0"
end

define function start_level_2
    # Level 2: Push around wall
    # Player (1,3), Box (3,3), Wall (5,3), Goal (6,1)
    # Must push box UP then RIGHT to reach goal
    set player.x to 275
    set player.y to 325
    set box1.x to 375
    set box1.y to 325
    set wall1.x to 475
    set wall1.y to 325
    set wall1.visible to true
    set goal1.x to 525
    set goal1.y to 225
    set level_text.text to "Level 2"
    set state.level to 2
    set state.moves to 0
    set moves_text.text to "Moves: 0"
    set win_text.visible to false
    set next_level_text.visible to false
end

define function show_victory
    set win_text.text to "You Win!"
    set win_text.visible to true
    set next_level_text.text to "Press R to play again"
    set next_level_text.visible to true
    set state.level to 3
end

define function restart_level
    set win_text.visible to false
    set next_level_text.visible to false
    if state.level is equal to 1 then
        call start_level_1
    end
    if state.level is equal to 2 then
        call start_level_2
    end
    if state.level is equal to 3 then
        call start_level_1
    end
end

# === SCREEN TRANSITIONS ===
when space_pressed then
    # From title -> Level 1
    if state.level is equal to 0 then
        set title.visible to false
        set subtitle.visible to false
        set instructions.visible to false
        set start_text.visible to false
        set player.visible to true
        set box1.visible to true
        set goal1.visible to true
        set level_text.visible to true
        set moves_text.visible to true
        call start_level_1
    end
end

when space_pressed then
    # From Level 1 win -> Level 2
    if state.level is equal to 1 then
        if win_text.visible is equal to true then
            call start_level_2
        end
    end
end

# === GRID MOVEMENT ===
# Move LEFT
when key_left then
    if state.level is above 0 then
        if state.level is below 3 then
            if win_text.visible is equal to false then
                if player.x is above 250 then
                # Check if player destination is blocked by wall
                set state.can_move to 1
                if player.x minus 50 is equal to wall1.x then
                    if player.y is equal to wall1.y then
                        set state.can_move to 0
                    end
                end
                if state.can_move is equal to 1 then
                    if player.x is equal to box1.x plus 50 then
                        if player.y is equal to box1.y then
                            # Pushing box - check box destination
                            set state.can_move to 1
                            if box1.x minus 50 is equal to wall1.x then
                                if box1.y is equal to wall1.y then
                                    set state.can_move to 0
                                end
                            end
                            if state.can_move is equal to 1 then
                                if box1.x is above 250 then
                                    set box1.x to box1.x minus 50
                                    set player.x to player.x minus 50
                                    set state.moves to state.moves plus 1
                                end
                            end
                        else
                            set player.x to player.x minus 50
                            set state.moves to state.moves plus 1
                        end
                    else
                        set player.x to player.x minus 50
                        set state.moves to state.moves plus 1
                    end
                end
            end
            end
        end
    end
end

# Move RIGHT
when key_right then
    if state.level is above 0 then
        if state.level is below 3 then
            if win_text.visible is equal to false then
                if player.x is below 550 then
                # Check if player destination is blocked by wall
                set state.can_move to 1
                if player.x plus 50 is equal to wall1.x then
                    if player.y is equal to wall1.y then
                        set state.can_move to 0
                    end
                end
                if state.can_move is equal to 1 then
                    if player.x is equal to box1.x minus 50 then
                        if player.y is equal to box1.y then
                            # Pushing box - check box destination
                            set state.can_move to 1
                            if box1.x plus 50 is equal to wall1.x then
                                if box1.y is equal to wall1.y then
                                    set state.can_move to 0
                                end
                            end
                            if state.can_move is equal to 1 then
                                if box1.x is below 550 then
                                    set box1.x to box1.x plus 50
                                    set player.x to player.x plus 50
                                    set state.moves to state.moves plus 1
                                end
                            end
                        else
                            set player.x to player.x plus 50
                            set state.moves to state.moves plus 1
                        end
                    else
                        set player.x to player.x plus 50
                        set state.moves to state.moves plus 1
                    end
                end
            end
            end
        end
    end
end

# Move UP
when key_up then
    if state.level is above 0 then
        if state.level is below 3 then
            if win_text.visible is equal to false then
                if player.y is above 200 then
                # Check if player destination is blocked by wall
                set state.can_move to 1
                if player.y minus 50 is equal to wall1.y then
                    if player.x is equal to wall1.x then
                        set state.can_move to 0
                    end
                end
                if state.can_move is equal to 1 then
                    if player.y is equal to box1.y plus 50 then
                        if player.x is equal to box1.x then
                            # Pushing box - check box destination
                            set state.can_move to 1
                            if box1.y minus 50 is equal to wall1.y then
                                if box1.x is equal to wall1.x then
                                    set state.can_move to 0
                                end
                            end
                            if state.can_move is equal to 1 then
                                if box1.y is above 200 then
                                    set box1.y to box1.y minus 50
                                    set player.y to player.y minus 50
                                    set state.moves to state.moves plus 1
                                end
                            end
                        else
                            set player.y to player.y minus 50
                            set state.moves to state.moves plus 1
                        end
                    else
                        set player.y to player.y minus 50
                        set state.moves to state.moves plus 1
                    end
                end
            end
            end
        end
    end
end

# Move DOWN
when key_down then
    if state.level is above 0 then
        if state.level is below 3 then
            if win_text.visible is equal to false then
                if player.y is below 400 then
                # Check if player destination is blocked by wall
                set state.can_move to 1
                if player.y plus 50 is equal to wall1.y then
                    if player.x is equal to wall1.x then
                        set state.can_move to 0
                    end
                end
                if state.can_move is equal to 1 then
                    if player.y is equal to box1.y minus 50 then
                        if player.x is equal to box1.x then
                            # Pushing box - check box destination
                            set state.can_move to 1
                            if box1.y plus 50 is equal to wall1.y then
                                if box1.x is equal to wall1.x then
                                    set state.can_move to 0
                                end
                            end
                            if state.can_move is equal to 1 then
                                if box1.y is below 400 then
                                    set box1.y to box1.y plus 50
                                    set player.y to player.y plus 50
                                    set state.moves to state.moves plus 1
                                end
                            end
                        else
                            set player.y to player.y plus 50
                            set state.moves to state.moves plus 1
                        end
                    else
                        set player.y to player.y plus 50
                        set state.moves to state.moves plus 1
                    end
                end
            end
            end
        end
    end
end

# === WIN DETECTION ===
define function check_win
    if box1.x is equal to goal1.x then
        if box1.y is equal to goal1.y then
            if state.level is equal to 1 then
                set win_text.text to "Level Complete!"
                set win_text.visible to true
                set next_level_text.visible to true
            end
            if state.level is equal to 2 then
                call show_victory
            end
        end
    end
end

define function update_display
    set moves_text.text to "Moves: {state.moves}"
end

# Check win after each move
when key_left then
    call check_win
    call update_display
end

when key_right then
    call check_win
    call update_display
end

when key_up then
    call check_win
    call update_display
end

when key_down then
    call check_win
    call update_display
end

# === RESTART ===
when key_r then
    call restart_level
end
