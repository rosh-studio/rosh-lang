# Scottish Heritage Gallery
# A cross-platform virtual exhibition showcasing Scottish national treasures
# Works in Three.js (3D), Phaser (2D), and CLI (text)

# Gallery settings
set title to "Scottish Heritage Gallery"
set description to "Discover Scotland's national treasures"

# =============================================================================
# GALLERY LAYOUT
# =============================================================================

# Floor and walls (rendered differently per platform)
create platform as floor
set floor color to gray
set floor x to 0
set floor y to 0
set floor scale to 10

# =============================================================================
# EXHIBITS
# =============================================================================

# Exhibit 1: Lewis Chess King
create lewis_chess_king as chess_king
set chess_king x to -3
set chess_king z to -2
set chess_king description to "The Lewis Chessmen - discovered 1831 on the Isle of Lewis"

# Exhibit 2: Lewis Chess Queen
create lewis_chess_queen as chess_queen
set chess_queen x to -1
set chess_queen z to -2

# Exhibit 3: Dolly the Sheep
create dolly_the_sheep as dolly
set dolly x to 1
set dolly z to -2

# Exhibit 4: Stirling Torc
create stirling_torc as torc
set torc x to 3
set torc z to -2

# Exhibit 5: Hunterston Brooch (uses sprite fallback)
create hunterston_brooch as brooch
set brooch x to 0
set brooch z to 2

# =============================================================================
# LABELS (Text objects)
# =============================================================================

create text as label1
set label1 text to "Lewis Chessmen"
set label1 x to -2
set label1 z to -3

create text as label2
set label2 text to "Dolly the Sheep"
set label2 x to 1
set label2 z to -3

create text as label3
set label3 text to "Iron Age Gold"
set label3 x to 3
set label3 z to -3

# =============================================================================
# WELCOME MESSAGE
# =============================================================================

print "Welcome to the Scottish Heritage Gallery"
print "Type 'look <object>' to learn more about each exhibit"
print "Type 'list' to see all objects"
