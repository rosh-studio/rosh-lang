# Scottish Heritage Gallery
# A cross-platform virtual exhibition showcasing Scottish national treasures
# Build: 2026-01-07-v2 (cache bust)

# =============================================================================
# EXHIBITS - Line left to right using x coordinates
# =============================================================================

# Lewis Chess King (far left)
create object chess_king
    set type to "lewis_chess_king"
    set x to -15
    set y to 2
    set z to 0
    set size to 4
    set description to "Lewis Chess King (c. 1150-1200 AD). Carved from walrus ivory, this regal figure is part of the famous Lewis Chessmen hoard discovered on the Isle of Lewis in 1831. The king sits on an ornate throne, clutching a sword across his lap. The pieces are thought to have been made in Trondheim, Norway, and may have been hidden by a merchant or buried for safekeeping."
    set credit to "The British Museum (CC BY-NC-SA)"
end

create object label_king
    set type to "text"
    set text to "Lewis Chess King"
    set x to -15
    set y to 10
    set z to 0
end

# Lewis Chess Queen (center-left)
create object chess_queen
    set type to "lewis_chess_queen"
    set x to -5
    set y to 2
    set z to 0
    set size to 4
    set description to "Lewis Chess Queen (c. 1150-1200 AD). This contemplative figure rests her chin on her hand in a gesture of thought or sorrow. The Lewis Chessmen are considered among the most significant archaeological finds in Scotland. Of the 93 pieces discovered, 82 are held by the British Museum and 11 by the National Museum of Scotland."
    set credit to "The British Museum (CC BY-NC-SA)"
end

create object label_queen
    set type to "text"
    set text to "Lewis Chess Queen"
    set x to -5
    set y to 10
    set z to 0
end

# Cutty Sark Cat (center-right)
create object cat
    set type to "cutty_sark_cat"
    set x to 5
    set y to 2
    set z to 0
    set size to 4
    set description to "Cutty Sark Ship's Cat. This bronze figurine commemorates the ships cats that served aboard the famous Cutty Sark clipper ship, built in 1869 at Dumbarton, Scotland. The Cutty Sark was one of the fastest tea clippers of her era, racing from China to London. Ships cats were considered good luck and helped control rodents that could damage cargo and ship's stores."
    set credit to "Cutty Sark Trust"
end

create object label_cat
    set type to "text"
    set text to "Cutty Sark Cat"
    set x to 5
    set y to 10
    set z to 0
end

# Invereen Stone (far right)
create object stone
    set type to "invereen_stone"
    set x to 15
    set y to 2
    set z to 0
    set size to 4
    set description to "Invereen Symbol Stone (c. 700-850 AD). This Class I Pictish stone features the distinctive double-disc and Z-rod symbol, along with a serpent. The Picts were a confederation of Celtic-speaking peoples who lived in what is now eastern and northern Scotland. Their symbol stones remain enigmatic - the meanings of their intricate carvings are still debated by scholars."
    set credit to "Catfish Jim and the soapdish (CC BY-SA 3.0)"
end

create object label_stone
    set type to "text"
    set text to "Invereen Stone"
    set x to 15
    set y to 10
    set z to 0
end

# =============================================================================
# WELCOME MESSAGE
# =============================================================================

print "Welcome to the Scottish Heritage Gallery"
print "Use look <object> to learn more"
print "Use list to see all objects"
