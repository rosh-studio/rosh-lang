# Scottish Heritage Gallery
# A cross-platform virtual exhibition showcasing Scottish national treasures

# =============================================================================
# EXHIBITS - Line left to right using x coordinates
# =============================================================================

# Lewis Chess King (far left)
create object chess_king
    set type to "lewis_chess_king"
    set x to -15
    set y to 2
    set z to 0
    set size to 4
    set description to "Lewis Chess King - 12th century Norse-Gaelic chess piece"
end

create object label_king
    set type to "text"
    set text to "Chess King"
    set x to -15
    set y to 10
    set z to 0
end

# Lewis Chess Queen (center-left)
create object chess_queen
    set type to "lewis_chess_queen"
    set x to -5
    set y to 2
    set z to 0
    set size to 4
    set description to "Lewis Chess Queen - found on the Isle of Lewis in 1831"
end

create object label_queen
    set type to "text"
    set text to "Chess Queen"
    set x to -5
    set y to 10
    set z to 0
end

# Cutty Sark Cat (center-right)
create object cat
    set type to "cutty_sark_cat"
    set x to 5
    set y to 2
    set z to 0
    set size to 4
    set description to "Cat figurehead from the Cutty Sark clipper ship"
end

create object label_cat
    set type to "text"
    set text to "Cutty Sark Cat"
    set x to 5
    set y to 10
    set z to 0
end

# Invereen Stone (far right)
create object stone
    set type to "invereen_stone"
    set x to 15
    set y to 2
    set z to 0
    set size to 4
    set description to "Pictish symbol stone from the National Museum of Scotland"
end

create object label_stone
    set type to "text"
    set text to "Invereen Stone"
    set x to 15
    set y to 10
    set z to 0
end

# =============================================================================
# WELCOME MESSAGE
# =============================================================================

print "Welcome to the Scottish Heritage Gallery"
print "Use look <object> to learn more"
print "Use list to see all objects"
