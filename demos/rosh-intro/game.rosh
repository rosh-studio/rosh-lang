# =============================================================================
# Rosh Intro - Simple Logo Demo
# =============================================================================
#
# The "rosh" logo - works in Phaser, Pygame, AND Three.js!
# "One language. Many worlds."
#
# BUILD FOR ALL TARGETS:
#   rosh build demos/rosh-intro/game.rosh --target phaser --output demos/rosh-intro/phaser/
#   rosh build demos/rosh-intro/game.rosh --target pygame --output demos/rosh-intro/pygame/
#   rosh build demos/rosh-intro/game.rosh --target threejs --output demos/rosh-intro/threejs/
#
# =============================================================================

# The logo
create object logo
    set text to "rosh"
    set x to 400
    set y to 300
    set font_size to 72
    set color to "cyan"
end

# Tagline
create object tagline
    set text to "one language. many worlds."
    set x to 400
    set y to 380
    set font_size to 18
    set color to "gray"
end
