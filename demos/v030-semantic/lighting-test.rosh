# =============================================================================
# LIGHTING TEST - Semantic Package Demo
# =============================================================================
#
# Tests all light types from rosh-lights package.
# Target: Three.js (3D browser)
#
# =============================================================================

meta.scene
    background "#0a0a1a"
end

# -----------------------------------------------------------------------------
# Ambient Light - base illumination
# -----------------------------------------------------------------------------
create light ambient as ambient
    set color to "#303040"
    set intensity to 0.4
end

# -----------------------------------------------------------------------------
# Directional Light - sun-like, casts shadows
# -----------------------------------------------------------------------------
create light sun as directional
    set color to "#ffffee"
    set intensity to 1.2
    set x to 20
    set y to 30
    set z to 20
    set cast_shadow to true
end

# -----------------------------------------------------------------------------
# Hemisphere Light - sky/ground gradient
# -----------------------------------------------------------------------------
create light sky as hemisphere
    set color to "#87CEEB"
    set ground_color to "#3d2817"
    set intensity to 0.3
end

# -----------------------------------------------------------------------------
# Spot Light - focused beam
# -----------------------------------------------------------------------------
create light spot1 as spot
    set color to "#ff6600"
    set intensity to 2.0
    set x to -5
    set y to 8
    set z to 0
    set angle to 25
    set penumbra to 0.4
    set cast_shadow to true
end

# -----------------------------------------------------------------------------
# Point Light - omnidirectional
# -----------------------------------------------------------------------------
create light bulb as point
    set color to "#ffff00"
    set intensity to 1.0
    set x to 5
    set y to 3
    set z to 5
end

# -----------------------------------------------------------------------------
# Scene Objects to show lighting effects
# -----------------------------------------------------------------------------

# Floor commented out - needs semantic positioning (see proposal)
# create object floor
#     set type to "plane"
#     set color to "#444444"
#     set scale to 30
#     set y to 0
#     set receive_shadows to true
# end

create object centerSphere
    set type to "sphere"
    set color to "#ffffff"
    set x to 0
    set y to 2
    set z to 0
    set size to 2
    set cast_shadow to true
end

create object leftCube
    set type to "cube"
    set color to "#ff4444"
    set x to -5
    set y to 1
    set z to 0
    set cast_shadow to true
end

create object rightCube
    set type to "cube"
    set color to "#4444ff"
    set x to 5
    set y to 1
    set z to 0
    set cast_shadow to true
end

create object backCylinder
    set type to "cylinder"
    set color to "#44ff44"
    set x to 0
    set y to 1.5
    set z to -5
    set cast_shadow to true
end
