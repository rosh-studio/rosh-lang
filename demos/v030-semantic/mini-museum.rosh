# =============================================================================
# MINI MUSEUM - Semantic Package Demo
# =============================================================================
#
# A small museum with spotlit pedestals.
# Demonstrates: rosh-lights, rosh-scene, rosh-camera
#
# Target: Three.js (3D browser)
#
# =============================================================================

meta.scene
    background "#0d0d15"
    fog_color "#0d0d15"
    fog_near 15
    fog_far 50
end

meta.camera
    position "0 4 12"
    target "0 1.5 0"
    fov 50
    controls "orbit"
end

# -----------------------------------------------------------------------------
# Lighting Setup
# -----------------------------------------------------------------------------

create light ambient as ambient
    set color to "#1a1a2e"
    set intensity to 0.2
end

# Spotlights for each pedestal
create light spot_left as spot
    set color to "#ffeedd"
    set intensity to 2.5
    set x to -4
    set y to 6
    set z to 0
    set angle to 20
    set penumbra to 0.5
    set cast_shadow to true
end

create light spot_center as spot
    set color to "#ddeeff"
    set intensity to 3.0
    set x to 0
    set y to 7
    set z to 0
    set angle to 25
    set penumbra to 0.4
    set cast_shadow to true
end

create light spot_right as spot
    set color to "#ffddee"
    set intensity to 2.5
    set x to 4
    set y to 6
    set z to 0
    set angle to 20
    set penumbra to 0.5
    set cast_shadow to true
end

# -----------------------------------------------------------------------------
# Floor - Using semantic coordinates: 0% = floor, 50% = center
# -----------------------------------------------------------------------------

create object floor
    set type to "plane"
    set color to "#1a1a1a"
    set scale to 30
    set x to 50%
    set y to 0%
    set receive_shadows to true
    set metalness to 0.3
    set roughness to 0.8
end

# -----------------------------------------------------------------------------
# Pedestals
# -----------------------------------------------------------------------------

create object pedestal_left
    set type to "cylinder"
    set color to "#2a2a2a"
    set x to -4
    set y to 0.75
    set z to 0
    set scale to 0.8
    set cast_shadow to true
end

create object pedestal_center
    set type to "cylinder"
    set color to "#2a2a2a"
    set x to 0
    set y to 1.0
    set z to 0
    set scale to 1.0
    set cast_shadow to true
end

create object pedestal_right
    set type to "cylinder"
    set color to "#2a2a2a"
    set x to 4
    set y to 0.75
    set z to 0
    set scale to 0.8
    set cast_shadow to true
end

# -----------------------------------------------------------------------------
# Artifacts (simple shapes as placeholders)
# -----------------------------------------------------------------------------

create object artifact_left
    set type to "torus"
    set color to "#cd7f32"
    set x to -4
    set y to 2.0
    set z to 0
    set size to 0.6
    set spin to "0 15 0"
    set metalness to 0.8
    set roughness to 0.2
end

create object artifact_center
    set type to "sphere"
    set color to "#4169e1"
    set x to 0
    set y to 2.8
    set z to 0
    set size to 0.8
    set spin to "5 10 0"
    set metalness to 0.2
    set roughness to 0.1
end

create object artifact_right
    set type to "cone"
    set color to "#c0c0c0"
    set x to 4
    set y to 2.0
    set z to 0
    set size to 0.7
    set spin to "0 -20 0"
    set metalness to 0.9
    set roughness to 0.1
end

