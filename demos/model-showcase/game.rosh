# Model Showcase Demo
# All available 3D models plus an empty space for demo recording
# Two scenes: "models" shows all models, "empty" is a blank canvas

meta
    title "Model Showcase"
    description "All available 3D models for demo recording"
    initial_scene "empty"
    use_shared_runtime true
end

# =============================================================================
# EMPTY SCENE - Blank canvas for creating objects
# =============================================================================

create object empty_title
    set scene to "empty"
    set text to "Demo Space"
    set x to 50%
    set y to 10%
    set z to -8
    set color to "white"
    set font_size to 48
end

create object empty_hint
    set scene to "empty"
    set text to "Type: go models  (to see all available models)"
    set x to 50%
    set y to 90%
    set z to -8
    set color to "gray"
    set font_size to 18
end

# =============================================================================
# MODELS SCENE - All available 3D models
# =============================================================================

# Row 1: Scottish Heritage
create object king1
    set scene to "models"
    set type to "lewis_chess_king"
    set x to -6
    set z to -6
    set scale to 2
end

create object queen1
    set scene to "models"
    set type to "lewis_chess_queen"
    set x to -3
    set z to -6
    set scale to 2
end

create object cat1
    set scene to "models"
    set type to "cutty_sark_cat"
    set x to 0
    set z to -6
    set scale to 2
end

create object stone1
    set scene to "models"
    set type to "invereen_stone"
    set x to 3
    set z to -6
    set scale to 1.5
end

# Row 2: Architecture
create object monument1
    set scene to "models"
    set type to "joanna_baillie_monument"
    set x to -4
    set z to -2
    set scale to 0.8
end

create object bank1
    set scene to "models"
    set type to "linen_bank"
    set x to 0
    set z to -2
    set scale to 0.4
end

create object castle1
    set scene to "models"
    set type to "castle"
    set x to 4
    set z to -2
    set scale to 0.3
end

# Row 3: Natural
create object tree1
    set scene to "models"
    set type to "tree"
    set x to -5
    set z to 2
    set scale to 1.5
end

create object apple1
    set scene to "models"
    set type to "apple"
    set x to -2
    set y to 0.5
    set z to 2
    set scale to 3
end

create object banana1
    set scene to "models"
    set type to "banana"
    set x to 0
    set y to 0.5
    set z to 2
    set scale to 3
end

create object ball1
    set scene to "models"
    set type to "football"
    set x to 2
    set y to 0.5
    set z to 2
    set scale to 2
end

# Row 4: Game Props
create object crate1
    set scene to "models"
    set type to "crate"
    set x to -4
    set z to 6
    set scale to 1.5
end

create object barrel1
    set scene to "models"
    set type to "barrel"
    set x to -1
    set z to 6
    set scale to 2
end

create object orc1
    set scene to "models"
    set type to "orc"
    set x to 3
    set z to 6
    set scale to 1.5
end

# Scene label
create object models_title
    set scene to "models"
    set text to "Available 3D Models"
    set x to 50%
    set y to 5%
    set z to -10
    set color to "white"
    set font_size to 36
end

create object models_hint
    set scene to "models"
    set text to "Type: go empty  (for blank demo space)"
    set x to 50%
    set y to 95%
    set z to -10
    set color to "gray"
    set font_size to 18
end
