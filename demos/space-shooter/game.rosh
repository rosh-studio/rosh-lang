# Space Shooter - Classic Arcade Game
# Refactored with loops and helper functions

set _meta mode to "arcade"
set _meta aspect to "landscape"

# === TITLE SCREEN ===
create object title
    set x to 50%
    set y to 25%
    set text to "Space Shooter"
    set color to "cyan"
    set font_size to 48
end

create object instructions
    set x to 50%
    set y to 45%
    set text to "O/P to move, SPACE to fire"
    set color to "white"
    set font_size to 18
end

create object start_text
    set x to 50%
    set y to 70%
    set text to "Press SPACE to start"
    set color to "yellow"
    set font_size to 20
end

# === PLAYER ===
create object player
    set x to 50%
    set y to 90%
    set width to 50
    set height to 50
    set sprite to "player.png"
    set color to "green"
    set visible to false
    set speed to 8
end

# === OBJECT POOLS ===
create 5 objects as bullets
    set x to 0
    set y to 0
    set width to 9
    set height to 33
    set sprite to "laserGreen.png"
    set color to "green"
    set visible to false
    set active to 0
end

create 4 objects as explosions
    set x to 0
    set y to 0
    set width to 64
    set height to 64
    set sprite to "explosion-sheet.png"
    set sprite_columns to 3
    set sprite_rows to 3
    set animations to explode
    set frame_rate to 20
    set visible to false
    set timer to 0
end

create 4 objects as enemies
    set x to 100
    set y to -50
    set width to 40
    set height to 40
    set sprite to "enemyShip.png"
    set color to "red"
    set visible to false
    set active to 0
    set speed to 2
end

# === UI ===
create object score_text
    set x to 70
    set y to 30
    set text to "Score: 0"
    set color to "white"
    set font_size to 20
    set visible to false
end

create object lives_text
    set x to 730
    set y to 30
    set text to "Lives: 3"
    set color to "green"
    set font_size to 20
    set visible to false
end

create object game_over_text
    set x to 50%
    set y to 45%
    set text to "GAME OVER"
    set color to "red"
    set font_size to 48
    set visible to false
end

create object final_score_text
    set x to 50%
    set y to 60%
    set text to "Final Score: 0"
    set color to "white"
    set font_size to 24
    set visible to false
end

create object restart_text
    set x to 50%
    set y to 75%
    set text to "Press R to restart"
    set color to "yellow"
    set font_size to 20
    set visible to false
end

# === GAME STATE ===
create object state
    set x to 0
    set y to 0
    set width to 1
    set height to 1
    set visible to false
    set level to 0
    set score to 0
    set lives to 3
    set next_explosion to 0
    set explosion_x to 0
    set explosion_y to 0
end

# === FUNCTIONS ===
define function start_game
    set title.visible to false
    set instructions.visible to false
    set start_text.visible to false
    set player.visible to true
    set score_text.visible to true
    set lives_text.visible to true
    set state.level to 1
    set state.score to 0
    set state.lives to 3
    set player.x to 400
    set score_text.text to "Score: 0"
    set lives_text.text to "Lives: 3"
    call spawn_enemy_wave
end

define function spawn_enemy_wave
    spawn enemies[0] at 100, -50
    spawn enemies[1] at 300, -100
    spawn enemies[2] at 500, -150
    spawn enemies[3] at 700, -200
end

define function show_explosion
    if state.next_explosion is equal to 0 then
        set explosions[0].x to state.explosion_x
        set explosions[0].y to state.explosion_y
        set explosions[0].visible to true
        set explosions[0].timer to 27
        play explode on explosions[0]
        set state.next_explosion to 1
    else if state.next_explosion is equal to 1 then
        set explosions[1].x to state.explosion_x
        set explosions[1].y to state.explosion_y
        set explosions[1].visible to true
        set explosions[1].timer to 27
        play explode on explosions[1]
        set state.next_explosion to 2
    else if state.next_explosion is equal to 2 then
        set explosions[2].x to state.explosion_x
        set explosions[2].y to state.explosion_y
        set explosions[2].visible to true
        set explosions[2].timer to 27
        play explode on explosions[2]
        set state.next_explosion to 3
    else if state.next_explosion is equal to 3 then
        set explosions[3].x to state.explosion_x
        set explosions[3].y to state.explosion_y
        set explosions[3].visible to true
        set explosions[3].timer to 27
        play explode on explosions[3]
        set state.next_explosion to 0
    end
end

define function fire_bullet
    play sound "laser1.ogg"
    get next from bullets where active is 0
    spawn at player.x, player.y minus 30
end

define function update_score
    set score_text.text to "Score: {state.score}"
end

define function update_lives
    set lives_text.text to "Lives: {state.lives}"
    if state.lives is equal to 0 then
        call game_over
    end
end

define function game_over
    set state.level to 0
    set player.visible to false
    set score_text.visible to false
    set lives_text.visible to false
    # Deactivate all bullets and enemies
    for bullet in bullets then
        deactivate bullet
    end
    for enemy in enemies then
        deactivate enemy
    end
    # Show game over screen
    set game_over_text.visible to true
    set final_score_text.text to "Final Score: {state.score}"
    set final_score_text.visible to true
    set restart_text.visible to true
end

define function restart_game
    set game_over_text.visible to false
    set final_score_text.visible to false
    set restart_text.visible to false
    # Deactivate bullets and enemies for clean restart
    for bullet in bullets then
        deactivate bullet
    end
    for enemy in enemies then
        deactivate enemy
    end
    call start_game
end

# === INPUT HANDLERS ===
when space_pressed then
    if state.level is equal to 0 then
        call start_game
    end
    if state.level is above 0 then
        call fire_bullet
    end
end

when while_key_o then
    if state.level is above 0 then
        if player.x is above 30 then
            move player left by 5
        end
    end
end

when while_key_p then
    if state.level is above 0 then
        if player.x is below 770 then
            move player right by 5
        end
    end
end

when key_r then
    if state.level is equal to 0 then
        if game_over_text.visible is equal to true then
            call restart_game
        end
    end
end

# === GAME LOOP ===
when update then
    if state.level is above 0 then
        # Move bullets upward
        for bullet in bullets then
            if bullet.active is equal to 1 then
                move bullet up by 10
                if bullet is offscreen then
                    deactivate bullet
                end
            end
        end

        # Move enemies downward
        for enemy in enemies then
            if enemy.active is equal to 1 then
                move enemy down by 2
                if enemy.y is above 650 then
                    set enemy.y to -50
                end
            end
        end

        # Collision: bullets vs enemies (using collides operator)
        for bullet in bullets then
            for enemy in enemies then
                if bullet collides with enemy then
                    play sound "lose1.ogg"
                    set state.explosion_x to enemy.x
                    set state.explosion_y to enemy.y
                    call show_explosion
                    set enemy.y to -50
                    deactivate bullet
                    set state.score to state.score plus 10
                    call update_score
                end
            end
        end

        # Collision: enemies vs player (using collides operator)
        for enemy in enemies then
            if enemy collides with player then
                play sound "lose3.ogg"
                set enemy.y to -50
                set state.lives to state.lives minus 1
                call update_lives
            end
        end

        # Explosion timers
        for explosion in explosions then
            if explosion.timer is above 0 then
                set explosion.timer to explosion.timer minus 1
                if explosion.timer is equal to 0 then
                    set explosion.visible to false
                end
            end
        end
    end
end
