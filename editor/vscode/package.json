{
  "name": "rosh",
  "displayName": "Rosh Language Support",
  "description": "Syntax highlighting and language support for Rosh - v0.0.6 with type annotations, semicolons, and stop command",
  "version": "0.6.0",
  "publisher": "rosh",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "rosh",
        "aliases": [
          "Rosh",
          "rosh"
        ],
        "extensions": [
          ".rosh"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "rosh",
        "scopeName": "source.rosh",
        "path": "./syntaxes/rosh.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "rosh",
        "path": "./snippets/rosh.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/rosh"
  }
}
