{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rosh",
  "scopeName": "source.rosh",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#constants"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.rosh",
          "match": "#.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.rosh",
          "match": "\\b(if|then|else|end|while|for|in|step|break|continue|return|stop|exit|go)\\b"
        },
        {
          "name": "keyword.control.event.rosh",
          "match": "\\b(when|trigger|on)\\b"
        },
        {
          "name": "keyword.declaration.rosh",
          "match": "\\b(create|object|set|define|function|make)\\b"
        },
        {
          "name": "keyword.type.rosh",
          "match": "\\b(number|string|boolean|list|any|null)\\b"
        },
        {
          "name": "keyword.other.rosh",
          "match": "\\b(to|as|from|all|at|with)\\b"
        },
        {
          "name": "keyword.io.rosh",
          "match": "\\b(print|say|get|dump|save|load|prompt|read|write|import|input)\\b"
        },
        {
          "name": "keyword.function.rosh",
          "match": "\\b(call|return)\\b"
        },
        {
          "name": "keyword.object.rosh",
          "match": "\\b(clone|delete|properties|props|look|examine|list|hide|show|move|reset)\\b"
        },
        {
          "name": "keyword.meta.rosh",
          "match": "\\b(meta|count|help|credits)\\b"
        },
        {
          "name": "keyword.undo.rosh",
          "match": "\\b(undo|redo|oops|repeat)\\b"
        },
        {
          "name": "keyword.list.rosh",
          "match": "\\b(append|remove|contains|length|of)\\b"
        },
        {
          "name": "keyword.string.rosh",
          "match": "\\b(split|substring|lowercase|uppercase|trim|indexOf|lastIndexOf)\\b"
        },
        {
          "name": "keyword.math.rosh",
          "match": "\\b(random|abs|min|max|round|floor|ceil)\\b"
        },
        {
          "name": "keyword.operator.stack.rosh",
          "match": "\\b(add|subtract|multiply|divide|dup|swap|drop|push|pop|peek|clear)\\b"
        },
        {
          "name": "keyword.operator.logical.rosh",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.comparison.rosh",
          "match": "\\b(is|equal|below|above)\\b"
        },
        {
          "name": "keyword.operator.arithmetic.rosh",
          "match": "\\b(plus|minus|times|divided|by)\\b"
        },
        {
          "name": "keyword.builtin.rosh",
          "match": "\\b(is_number|is_string|is_list|is_object|is_null|is_boolean)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.rosh",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.rosh",
              "match": "\\\\(n|t|\\\\|\"|')"
            }
          ]
        },
        {
          "name": "string.quoted.single.rosh",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.rosh",
              "match": "\\\\(n|t|\\\\|\"|')"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.rosh",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "punctuation.accessor.rosh",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.rosh",
          "match": ";"
        },
        {
          "name": "punctuation.separator.rosh",
          "match": ","
        },
        {
          "name": "keyword.operator.type.annotation.rosh",
          "match": ":"
        },
        {
          "name": "punctuation.section.brackets.rosh",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.angle.rosh",
          "match": "[<>]"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.rosh",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    }
  }
}
