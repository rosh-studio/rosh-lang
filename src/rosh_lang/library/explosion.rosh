# widget: explosion
# version: 0.1
# description: Visual flash effect — grows then shrinks, destroys when done
# config: color=#ff4444
# licence: Rosh-BSL

create object flash
set flash.x to 0.5
set flash.y to 0.5
set flash.width to 0
set flash.height to 0

create number active
set active to 0

create number size
set size to 0

set flash.color to "#ff4444"

sound boom "explosion blast"

on update when active > 0 set size to size + 0.02
on update when size > 0.15 set active to 0
on update when active < 1 set size to 0
