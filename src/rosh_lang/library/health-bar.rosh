# widget: health-bar
# version: 0.1
# description: Health display with current and max values
# config: max=100 current=100
# licence: Rosh-BSL

create number max
set max to 100

create number current
set current to 100

create object display
set display.label to "HP: {current}/{max}"
set display.x to 0.02
set display.y to 0.10
set display.width to 0.20
set display.height to 0.06
set display.color to "#2a6e2a"
