# widget: lives
# version: 0.1
# description: Lives display with count
# config: count=3
# licence: Rosh-BSL

create number count
set count to 3

create object display
set display.label to "Lives: {count}"
set display.x to 0.02
set display.y to 0.18
set display.width to 0.15
set display.height to 0.06
set display.color to "#663333"
