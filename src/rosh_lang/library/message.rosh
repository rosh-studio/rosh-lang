# widget: message
# version: 0.1
# description: Text overlay with configurable position, color, and content
# config: text=Hello x=0.3 y=0.4 color=#fff bg=#333
# licence: Rosh-BSL

create object box
set box.x to 0.3
set box.y to 0.4
set box.width to 0.4
set box.height to 0.08
set box.color to "#333"
set box.label to "Hello"
