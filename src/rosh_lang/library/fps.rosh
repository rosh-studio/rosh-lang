# widget: fps
# version: 0.4
# description: FPS counter for game loop
# config: x=0.90 y=0.95 bg=#222 text_color=#fff font_size=14px
# provides:
# requires:
# exposes: frames
# licence: Rosh-BSL

create number frames
set frames to 0

create object display
set display.label to "FPS: {frames}"
set display.x to config.x
set display.y to config.y
set display.width to 0.10
set display.height to 0.04
set display.color to config.bg
set display.text_color to config.text_color
set display.font_size to config.font_size
