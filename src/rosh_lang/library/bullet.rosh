# widget: bullet
# version: 0.1
# description: Single projectile that moves up on update
# config: speed=0.02 color=#ffff00
# licence: Rosh-BSL

create object obj
set obj.x to -1
set obj.y to -1
set obj.width to 0.02
set obj.height to 0.04
set obj.color to "#ffff00"
set obj.label to ""

create number speed
set speed to 0.02

sound pew "short laser shot"

on update set obj.y to obj.y - 0.02
on update when obj.y < 0 destroy obj
