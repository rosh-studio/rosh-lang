#!/usr/bin/env rosh
"""
========================================
THE ROSH MANUAL
========================================
The comprehensive, executable guide to the Rosh programming language

This file demonstrates ALL working features of Rosh with executable examples.
It serves as both:
  - The official language tutorial
  - The integration test suite (run before each release)

Run with: rosh ROSH-MANUAL.rosh
Or:       python -m rosh ROSH-MANUAL.rosh

Last updated: v0.1.9
"""

print "=== WELCOME TO ROSH ==="
print "An English-like programming language for interactive storytelling"
print

# ========================================
# 1. BASIC VALUES AND VARIABLES
# ========================================
print "=== 1. Basic Values and Variables ==="

# Modern syntax: 'set' for variables, 'create' for objects
set age to 25
set name to "Alice"
set score to 100

print "Name:"
print name
print "Age:"
print age
print

# Classic syntax also works (backward compatible)
create number health to 100
print "Health (classic syntax):"
print health
print

# ========================================
# 2. ARITHMETIC OPERATIONS
# ========================================
print "=== 2. Arithmetic Operations ==="

set sum to 10 plus 5
set difference to 20 minus 7
set product to 6 times 7
set quotient to 100 divided by 4

print "10 plus 5 ="
print sum
print "6 times 7 ="
print product

# Negative numbers
set negative to -10
set calculation to 5 plus -3
print "5 plus -3 ="
print calculation
print

# ========================================
# 3. COMMENTS
# ========================================
print "=== 3. Comments ==="

# Single-line comments start with #
print "Single-line comments work"

"""
Multiline comments can use triple quotes.
They can span multiple lines.
"""
print "Triple quote comments work!"

###
Multiline comments can also use triple hashes.
Use whichever style you prefer!
###
print "Triple hash comments work!"
print

# ========================================
# 4. RESERVED WORDS
# ========================================
print "=== 4. Reserved Words ==="

# Reserved words protect core language features (~70 total)
# Examples: if, then, else, end, while, for, create, set, stack, print

# You CAN use similar names:
set mystack to [1, 2, 3]
set player_health to 100

print "Variables with similar names to reserved words work fine!"

# You CANNOT use exact reserved words as variable names:
# create number stack to 5  <- Would error!

set value to 42
get value
print "The stack command works:"
print stack
print

# ========================================
# 5. COMPARISONS
# ========================================
print "=== 5. Comparisons ==="

set x to 15

if x is above 10 then
    print "x is greater than 10"
end

if x is equal to 15 then
    print "x equals 15"
end
print

# ========================================
# 6. BOOLEAN OPERATORS (AND/OR/NOT)
# ========================================
print "=== 6. Boolean Operators ==="

set temp to 72

# AND - both conditions must be true
if temp is above 65 and temp is below 80 then
    print "Temperature is comfortable (65-80)"
end

# OR - at least one condition must be true
if temp is below 60 or temp is above 90 then
    print "Temperature is extreme"
else
    print "Temperature is moderate"
end

# NOT - negates a condition
if not temp is below 50 then
    print "It's not freezing"
end

# NOT in compound expressions
set x to 5
set y to 10
if x is above 0 and not y is below 5 then
    print "x is positive AND y is not less than 5"
end
print

# ========================================
# 7. IF/ELSE CONDITIONALS
# ========================================
print "=== 7. If/Else Conditionals ==="

set grade to 85

if grade is above 90 then
    print "Grade: A"
else if grade is above 80 then
    print "Grade: B"
else if grade is above 70 then
    print "Grade: C"
else
    print "Grade: F"
end
print

# ========================================
# 8. WHILE LOOPS
# ========================================
print "=== 8. While Loops ==="

set countdown to 5
print "Countdown:"
while countdown is above 0 then
    print countdown
    set countdown to countdown minus 1
end
print "Liftoff!"
print

# ========================================
# 9. FOR LOOPS
# ========================================
print "=== 9. For Loops ==="

print "Count 1 to 5:"
for i in 1 to 5 then
    print i
end

print "Count by 2s:"
for i in 2 to 10 step 2 then
    print i
end
print

# ========================================
# 10. BREAK, CONTINUE, AND STOP
# ========================================
print "=== 10. Break, Continue, and Stop ==="

print "Break example (stop at 5):"
for i in 1 to 10 then
    if i is equal to 6 then
        break
    end
    print i
end

print "Continue example (skip 3):"
for i in 1 to 5 then
    if i is equal to 3 then
        continue
    end
    print i
end

# 'stop' or 'exit' terminates the program immediately
print "Use 'stop' or 'exit' to terminate program"
print

# ========================================
# 11. LISTS AND ARRAYS
# ========================================
print "=== 11. Lists and Arrays ==="

set numbers to [10, 20, 30, 40, 50]
set fruits to ["apple", "banana", "cherry"]

print "Numbers list:"
print numbers

# Access elements (0-based indexing)
print "First number:"
get numbers[0]
print stack

# Modify elements
set numbers[1] to 99
print "After changing second element:"
print numbers

# List slicing
set values to [100, 200, 300, 400, 500]
set slice1 to values[1:3]
print "values[1:3]:"
print slice1

set slice2 to values[:3]
print "values[:3]:"
print slice2
print

# ========================================
# 12. FUNCTIONS
# ========================================
print "=== 12. Functions ==="

define function greet person
    print "Hello,"
    print person
end

call greet "Bob"

define function double x
    return x times 2
end

call double 7
print "7 doubled:"
print stack

# Assign return value to variable
set value to call double 15
print "15 doubled (assigned):"
print value
print

# ========================================
# 13. OBJECTS AND PROPERTIES
# ========================================
print "=== 13. Objects and Properties ==="

# Natural language syntax options:
#   create object banana     (explicit - full form)
#   create banana            (implied 'object' - creates empty object)
#   create a banana          (natural English - 'a' is ignored)
#   make banana              ('make' is alias for 'create')
#   make an apple            (combining both features)

# Quick object creation (empty objects)
make a ball
create an orange

print "Quick objects created:"
print ball
print orange
print

# Full object with properties
create object player
    set name to "Hero"
    set health to 100
    set mana to 50
end

print "Player name:"
print player.name

# BOTH SYNTAXES WORK for property access:
set player.health to 85      # Dot syntax
set player health to 80      # Natural language (same effect!)
print "Health after damage:"
print player.health

# Clone objects
clone player as enemy
set enemy.name to "Goblin"
set enemy health to 30       # Natural language syntax

print "Enemy name:"
print enemy.name
print "Enemy health:"
print enemy.health
print

# ========================================
# 14. FOR LOOPS - COLLECTIONS
# ========================================
print "=== 14. For Loops - Collections ==="

create object item
    set name to "item"
    set value to 0
end

clone item as sword
set sword name to "Iron Sword"    # Natural language
set sword value to 150            # Natural language

clone item as shield
set shield.name to "Wooden Shield"
set shield.value to 75

print "Inventory:"
for obj in all item then
    print "- "
    get obj.name
    print
end
print

# ========================================
# 15. BOOLEAN VALUES
# ========================================
print "=== 15. Boolean Values ==="

set is_active to true
set is_locked to false
set nothing to null

if is_active then
    print "System is active"
end

if not is_locked then
    print "Door is unlocked"
end
print

# ========================================
# 16. STRING AND LIST LENGTH
# ========================================
print "=== 16. String and List Length ==="

set message to "Hello Rosh"
set msg_len to length of message
print "String length:"
print msg_len

set items to [1, 2, 3, 4, 5]
set item_count to length of items
print "List length:"
print item_count
print

# ========================================
# 17. RANDOM NUMBERS
# ========================================
print "=== 17. Random Numbers ==="

set die_roll to random 1 to 6
print "Die roll:"
print die_roll

set damage to random 5 to 15
print "Random damage:"
print damage
print

# ========================================
# 18. STRING OPERATIONS
# ========================================
print "=== 18. String Operations ==="

# Concatenation
set greeting to "Hello" plus " " plus "World"
print greeting

set player_name to "Hero"
set welcome to "Welcome " plus player_name
print welcome

# Contains
set command to "go north"
if command contains "north" then
    print "Player wants to go north"
end

set inventory to ["sword", "shield", "potion"]
if inventory contains "sword" then
    print "Player has a sword"
end
print

# ========================================
# 19. LIST OPERATIONS
# ========================================
print "=== 19. List Operations ==="

set inventory to ["sword"]
print "Starting inventory:"
print inventory

append "shield" to inventory
append "potion" to inventory
print "After adding items:"
print inventory

remove "sword" from inventory
print "After removing sword:"
print inventory
print

# ========================================
# 20. MATH FUNCTIONS
# ========================================
print "=== 20. Math Functions ==="

call abs -25
print "Absolute value of -25:"
print stack

call min 10 5 20 3 15
print "Minimum of 10,5,20,3,15:"
print stack

call max 10 5 20 3 15
print "Maximum:"
print stack

call round 7.6
print "7.6 rounded:"
print stack
print

# ========================================
# 21. TYPE CHECKING FUNCTIONS
# ========================================
print "=== 21. Type Checking Functions ==="

set test_num to 42
set result to call is_number test_num
print "is_number(42):"
print result

set test_str to "hello"
set result to call is_string test_str
print "is_string(\"hello\"):"
print result

set test_list to [1, 2, 3]
set result to call is_list test_list
print "is_list([1,2,3]):"
print result
print

# ========================================
# 22. TYPE ANNOTATIONS
# ========================================
print "=== 22. Type Annotations ==="

# Type inference (automatic)
set x to 42                       # Infers: number
set message to "Hello"            # Infers: string
set items to [1, 2, 3]            # Infers: list<number>

# Optional type annotations - two syntaxes:
set score: number to 100          # Using colon
set hero_name as string to "Hero" # Using 'as'
set is_ready: boolean to true

print "Type inference works automatically"
print x
print message

# List type annotations
set numbers as list<number> to [10, 20, 30]
set names as list<string> to ["Alice", "Bob"]

print "Typed lists:"
print numbers
print names
print

# ========================================
# 23. STRING INTERPOLATION
# ========================================
print "=== 23. String Interpolation ==="

set player_name to "Hero"
set player_level to 12
set player_health to 85

print "Player: {player_name}"
print "Level: {player_level}"
print "Health: {player_health}/100"

# Works with expressions
print "Next level: {player_level plus 1}"

# Works with object properties
create object weapon
    set name to "Sword of Destiny"
    set damage to 25
end

print "Equipped: {weapon.name} (Damage: {weapon.damage})"
print

# ========================================
# 24. USER INPUT
# ========================================
print "=== 24. User Input ==="

# Note: Commented out as it requires interaction
# print "What is your name? "
# input user_name
# print "Hello {user_name}!"

print "Input syntax: input <variable_name>"
print "Reads a line from stdin into the variable"
print

# ========================================
# 25. STACK OPERATIONS
# ========================================
print "=== 25. Stack Operations ==="

set a to 10
set b to 20
set c to 30

# Push values onto stack with 'get'
get a
get b
get c

# View the stack
print "Stack contents:"
stack

# Stack manipulation
dup
print "After dup:"
stack

swap
print "After swap:"
stack

drop
print "After drop:"
stack

# Stack math
set x to 5
set y to 3
get x
get y
add
print "5 + 3 from stack:"
print stack
print

# ========================================
# 26. EVENT SYSTEM
# ========================================
print "=== 26. Event System ==="

# Simple event with no parameters
when game_over then
    print "Game Over!"
    print "Thanks for playing!"
end

print "Triggering game_over event:"
trigger game_over
print

# Event with parameters
when player_damaged amount then
    print "Player took {amount} damage!"
end

print "Triggering player_damaged with 25:"
trigger player_damaged with 25
print

# Multiple handlers for same event
when victory then
    print "Victory!"
end

when victory then
    print "Final Score: 1000"
end

print "Triggering victory (runs both handlers):"
trigger victory
print

# Events with object parameters
create object hero
    set name to "Knight"
    set health to 100
end

create object goblin
    set name to "Goblin"
    set damage to 15
end

when combat_start attacker defender then
    print "{attacker.name} attacks {defender.name}!"
end

print "Combat event:"
trigger combat_start with goblin hero
print

# Events can modify game state
when take_damage target amount then
    set target health to target.health minus amount
    print "{target.name} health: {target.health}"
end

print "Damage system (using natural language syntax):"
trigger take_damage with hero 30
print

# ========================================
# 27. PROGRAM METADATA
# ========================================
print "=== 27. Program Metadata ==="

meta
    version "1.0.0"
    author "rosh-demo"
    license "MIT"
end

meta.generated
end

meta.game
    type "text"
    engine "rosh-cli"
end

print "Program metadata:"
get meta.version
print stack
get meta.author
print stack
get meta.generated.uuid
print stack
print

# ========================================
# 28. SCENES AND LEVELS (Transpiler)
# ========================================
print "=== 28. Scenes and Levels ==="

# Roshonic "Dimensions, Not Modes" - treat scenes/levels as coordinates
# Objects can belong to scenes (named) and levels (numbered)
# Objects without scene/level are always visible (HUD, backgrounds)

print "Scene/Level Syntax (for transpiled games):"
print "  set scene to \"title\"    # Object only visible in title scene"
print "  set level to 1          # Object only visible in level 1"
print "  goto scene game         # Navigate to game scene"
print "  goto level 2            # Navigate to level 2"
print "  goto scene game level 1 # Navigate to both"
print

print "Example game structure:"
print "  # Title screen (scene=\"title\")"
print "  create object title_text"
print "      set scene to \"title\""
print "      set text to \"My Game\""
print "  end"
print
print "  # Game objects (scene=\"game\", level=1)"
print "  create object player"
print "      set scene to \"game\""
print "      set level to 1"
print "  end"
print
print "  # HUD (no scene/level = always visible)"
print "  create object score_display"
print "      set text to \"Score: 0\""
print "  end"
print
print "  # Navigation"
print "  when space_pressed then"
print "      goto scene game level 1"
print "  end"
print

print "Note: 'level' alone is a regular property."
print "Only 'level' with 'scene' is treated as a coordinate."
print

# ========================================
# 29. ADVANCED FEATURES (Reference)
# ========================================
print "=== 29. Advanced Features ==="

print "TOML Support:"
print "  import \"config.toml\"   # Load as Rosh object"
print "  rosh script.rosh --toml # Output as TOML"
print

print "Test Mode (CI/CD):"
print "  rosh game.rosh --test inputs.txt"
print "  rosh game.rosh --test-input \"Alice,25\""
print

print "TOON Format (LLM-optimized, 40% fewer tokens):"
print "  rosh script.rosh --toon"
print "  save \"state.toon\""
print

# ========================================
# 30. REPL COMMANDS
# ========================================
print "=== 30. REPL Commands ==="

print "The Rosh REPL (rosh command with no arguments) has special commands:"
print

print "go - Auto-close blocks and execute:"
print "  create object banana"
print "      set color to yellow"
print "  go"
print "  # Automatically closes the 'create' block and runs"
print

print "undo / redo - Revert or redo changes:"
print "  set x to 100"
print "  undo           # Reverts x"
print "  redo           # Re-applies x = 100"
print "  undo 3         # Undo 3 steps"
print "  undo stack     # Show undo history"
print

print "oops - Natural language alias for undo:"
print "  oops           # Same as 'undo'"
print

print "Triple newline - Implied 'go':"
print "  create banana"
print "      set color to yellow"
print "  <blank>"
print "  <blank>"
print "  <blank>        # Three blank lines = 'go'"
print

print "list / look - Show all objects:"
print "  list           # or: look, ls, objects"
print

print "examine <obj> - Inspect object properties:"
print "  examine player # or: look player, x player"
print

print "get <obj> [prop] - Get object or property value:"
print "  get player         # Show player object"
print "  get player health  # Show player.health"
print

print "clear - Clear the screen"
print

print "alias - Create command shortcuts:"
print "  alias p print"
print "  p \"Hello!\"     # Expands to: print \"Hello!\""
print

# ========================================
# FEATURE SUMMARY
# ========================================
print "=== ROSH FEATURE SUMMARY ==="
print "Variables: set x to 42"
print "Objects: create object player"
print "Properties: set player.health OR set player health to 100"
print "Types: automatic inference, optional annotations"
print "Control: if/else, while, for loops, break/continue"
print "Functions: define function name params ... end"
print "Lists: [1,2,3], append, remove, slicing"
print "Events: when event then ... end; trigger event"
print "Scenes: set scene to \"title\"; goto scene game level 1"
print "Stack: get, stack, dup, swap, drop, math ops"
print "Strings: concatenation, contains, interpolation"
print "Math: abs, min, max, round, floor, ceil, random"
print "I/O: print, input"
print
print "Thanks for exploring Rosh!"
print "Visit github.com/rdubar/rosh for more information"
