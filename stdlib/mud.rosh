# 🤖 Rosh MUD Standard Library
# Provides base templates for building MUD/game worlds
#
# USAGE:
#   import mud
#   create room tavern       # Clone a room template
#   set tavern.name "The Rusty Tankard"
#   help room               # See all room properties
#
# TEMPLATES PROVIDED:
#   base-object  - Foundation for all objects (name, description)
#   room         - Locations with exits (north, south, east, west, up, down)
#   thing        - Movable objects (portable, weight, location)
#   character    - Living entities (health, strength, inventory)
#   player       - Player characters (level, experience)
#   npc          - Non-player characters (friendly, dialogue)
#   door         - Connections between rooms (open, locked)
#   container    - Objects that hold items (capacity, contents)
#   weapon       - Combat items (damage, durability)
#   armor        - Protective equipment (defense, durability)
#
# EXAMPLES:
#   # Create a room
#   create room tavern
#   set tavern.name "The Rusty Tankard"
#   set tavern.description "A cozy tavern with a roaring fireplace"
#
#   # Create an NPC
#   create npc barkeep
#   set barkeep.name "Old Tom"
#   set barkeep.dialogue "Welcome to my tavern!"
#
#   # Connect rooms
#   connect tavern north square
#
# === BASE TEMPLATES ===

# Base object - foundation for everything
create object base-object
  set name to ""
  set description to ""
end

# Thing - movable objects (items, weapons, etc.)
create object thing from base-object
  set type to "thing"
  set movable to true
  set portable to true
  set location to null
  set weight to 1
end

# Room - locations in the world
create object room from base-object
  set type to "room"
  set north to null
  set south to null
  set east to null
  set west to null
  set up to null
  set down to null
end

# Character - living entities (players, NPCs)
create object character from thing
  set type to "character"
  set health to 100
  set max-health to 100
  set alive to true
  set inventory to null
  set strength to 10
  set movable to false
end

# Door - connections between rooms
create object door from thing
  set type to "door"
  set open to false
  set locked to false
  set movable to false
  set portable to false
  set connects-to to null
end

# Container - objects that hold other objects
create object container from thing
  set type to "container"
  set open to true
  set capacity to 10
  set contents to null
end

# Weapon - combat items
create object weapon from thing
  set type to "weapon"
  set damage to 10
  set durability to 100
  set weight to 5
end

# Armor - protective items
create object armor from thing
  set type to "armor"
  set defense to 5
  set durability to 100
  set weight to 10
end

# NPC - non-player character
create object npc from character
  set type to "npc"
  set friendly to true
  set dialogue to null
end

# Player - player character template
create object player from character
  set type to "player"
  set level to 1
  set experience to 0
end
