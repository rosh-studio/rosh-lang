#!/usr/bin/env rosh
"""
ROSH STDLIB - Simple Game Loop
===============================
A tiny event loop for reactive game logic

USAGE:
    import "stdlib/game-loop-simple.rosh"

    # In your game, trigger game_tick manually
    while game_running is equal to true then
        trigger game_tick with tick_count
        set tick_count to tick_count plus 1

        # Your game logic here
        # Events will fire based on conditions you check
    end

This is a minimal stdlib that provides:
- Game loop state management
- Tick counting
- Helper functions for common patterns
"""

# ============================================
# GAME LOOP STATE
# ============================================

set game_running to true
set tick_count to 0
set max_ticks to 1000

# ============================================
# UTILITY FUNCTIONS
# ============================================

"""
Check if number is divisible by another (for periodic events)

Example:
  if call every 5 tick_count then
      print "This runs every 5 ticks"
  end
"""
define function every interval current
    # Type validation
    if call is_number interval is equal to false then
        print "ERROR: every() interval must be a number, got non-number"
        return false
    end

    if call is_number current is equal to false then
        print "ERROR: every() current must be a number, got non-number"
        return false
    end

    # Zero check
    if interval is equal to 0 then
        print "ERROR: every() interval cannot be zero"
        return false
    end

    # Negative interval makes no sense
    if interval is below 0 then
        print "ERROR: every() interval must be positive"
        return false
    end

    set remainder to current modulo interval
    if remainder is equal to 0 then
        return true
    end
    return false
end

"""
Stop the game loop

Example:
  when game_over then
      call stop_loop
  end
"""
define function stop_loop
    set game_running to false
end

"""
Reset tick count

Example:
  call reset_ticks
"""
define function reset_ticks
    set tick_count to 0
end

# Library loaded - no banner output
# Available:
#   - game_running (set to false to stop)
#   - tick_count (current tick)
#   - max_ticks (safety limit)
#   - every(interval, current) → true every N ticks
#   - stop_loop() → stops the game
#   - reset_ticks() → resets counter
