# =============================================================================
# ROSH RUNTIME CONFORMANCE TEST SUITE
# =============================================================================
#
# Purpose:  Verify Python CLI and JS Runtimes produce equivalent results
# Version:  0.2.3
# Date:     2025-12-29
#
# How to use:
#   Python: rosh test spec/v0.2.3/runtime-conformance.rosh
#   JS:     (future) node rosh-test.js spec/v0.2.3/runtime-conformance.rosh
#
# Test format uses expect assertions that work across runtimes:
#   - expect <obj> exists       → object is in registry
#   - expect <obj>.<prop> is X  → property has value X
#   - expect <obj> not exists   → object was deleted
#   - expect scenes contains X  → scene X is available
#
# =============================================================================

section "runtime-conformance"

# -----------------------------------------------------------------------------
# Object Creation
# -----------------------------------------------------------------------------

test "create adds object to registry"
    create box
    expect box exists
endtest

test "create with type stores type"
    create sphere
    expect sphere exists
endtest

test "multiple creates use unique names"
    create cube
    create cube
    # Both should exist (auto-named cube-1, cube-2 or similar)
    expect cube exists
endtest

# -----------------------------------------------------------------------------
# Property Setting
# -----------------------------------------------------------------------------

test "set color property"
    create thing
    set thing color to "red"
    expect thing.color is "red"
endtest

test "set position x"
    create obj
    set obj x to 100
    expect obj.x is 100
endtest

test "set position y"
    create obj2
    set obj2 y to 200
    expect obj2.y is 200
endtest

test "set custom property"
    create item
    set item status to "active"
    expect item.status is "active"
endtest

# -----------------------------------------------------------------------------
# Object Deletion
# -----------------------------------------------------------------------------

test "delete removes from registry"
    create temp
    delete temp
    expect temp not exists
endtest

# -----------------------------------------------------------------------------
# Scene System
# -----------------------------------------------------------------------------

test "set scene property"
    create room_obj
    set room_obj scene to "gallery"
    expect room_obj.scene is "gallery"
endtest

# Note: Scene navigation (go) behavior differs between runtimes
# Python: sets current-scene variable
# JS: changes object visibility
# We test the common subset: scene property on objects

# -----------------------------------------------------------------------------
# Visibility
# -----------------------------------------------------------------------------

test "hide sets visible to false"
    create vis_test
    hide vis_test
    expect vis_test.visible is False
endtest

test "show sets visible to true"
    create vis_test2
    hide vis_test2
    show vis_test2
    expect vis_test2.visible is True
endtest

# -----------------------------------------------------------------------------
# Clone
# -----------------------------------------------------------------------------

test "clone creates copy"
    create original
    set original color to "blue"
    clone original
    # Clone exists (name varies by runtime)
    expect original exists
endtest

# =============================================================================
# COMMANDS BOTH RUNTIMES MUST SUPPORT
# =============================================================================
#
# Core (required):
#   create <type>           - Create object
#   delete <name>           - Delete object
#   set <obj> <prop> to <v> - Set property
#   get <obj>               - Select object
#   list                    - List objects
#   hide <obj>              - Make invisible
#   show <obj>              - Make visible
#   clone <obj>             - Duplicate
#   undo                    - Undo last
#   redo                    - Redo undone
#
# Scene (if implemented):
#   scenes                  - List scenes
#   go <scene>              - Navigate
#   list <scene>            - Objects in scene
#
# Extended (nice to have):
#   move <obj> to X Y       - Position
#   move <obj> <dir> <amt>  - Relative move
#   get <modifiers> <type>  - Deep search
#   count [type]            - Count objects
#   save/load [slot]        - Persistence
#
# =============================================================================
