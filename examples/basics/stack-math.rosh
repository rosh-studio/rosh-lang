# Stack-based math operations

create a to 10
create b to 20

# Traditional approach with expressions
create sum to a plus b
print sum

# Stack-based approach with operators
# Add: 10 + 20 = 30
get a
get b
add
print

# Multiply: 10 * 20 = 200
get a
get b
multiply
print

# Complex calculation: (10 + 20) * 2 = 60
get a
get b
add
create two to 2
get two
multiply
print
