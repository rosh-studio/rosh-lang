# Eval Command Demo
# Execute Rosh code from strings

print "📝 Eval Demo"
print "============"
print ""

# Example 1: Simple eval
print "Example 1: Execute code from string"
create code to "create x to 42"
eval code
print "x ="
print x
print ""

# Example 2: Multi-line code
print "Example 2: Multi-line code"
create player_code to "create object player
  set name to 'Hero'
  set health to 100
end"
eval player_code
print "Player:"
print player
print ""

# Example 3: Dynamic code generation
print "Example 3: Build code dynamically"
create var_name to "score"
create value to 1500
# Note: In real use, you'd concatenate strings
# For now, we'll just eval a simple case
eval "create score to 1500"
print "Score:"
print score
