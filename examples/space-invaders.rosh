# Space Invaders — a simple arcade game in Rosh
# Run: rosh examples/space-invaders.rosh --target web --run

# === WIDGETS ===
use player speed 0.03 move x
use enemy-grid rows 3 cols 6 drift 0.003
use bullet
use score
use lives count 3
use explosion

# === EVENTS ===

# Space bar fires a bullet from the player's position
when keydown " "
  set bullet._x to player.x
  set bullet._y to player.y
  set bullet._fire to 1
end

# === COLLISIONS ===
# Bullet hits an enemy — score up, both recycled
when collision bullet.* enemy-grid.*
  set score.value to score.value + 100
  set explosion._x to b_x
  set explosion._y to b_y
  set explosion._fire to 1
  play explosion.boom
end

# Enemy reaches the player — lose a life
when collision enemy-grid.* player
  set lives.count to lives.count - 1
  set explosion._x to player.x
  set explosion._y to player.y
  set explosion._fire to 1
  play explosion.boom
  send check-lives
end

# === GAME OVER (auto-fired by lives widget) ===
when game-over
  print "GAME OVER — Final Score: {score.value}"
end

# === START ===
when start
  set score.value to 0
  set lives.count to 3
  print "Arrow keys to move, Space to fire"
end
