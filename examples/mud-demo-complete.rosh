# Complete MUD Demo - Shows all new features

print "=== Complete Rosh MUD Demo ==="
print ""

# Import MUD library
import mud

# Create rooms
print "Creating world..."
clone room as tavern
set tavern.name "The Rusty Tankard"
set tavern.description "A cozy tavern with wooden tables and a roaring fireplace."
set tavern.south "courtyard"

clone room as courtyard
set courtyard.name "Village Courtyard"
set courtyard.description "A bustling village square with cobblestone paths."
set courtyard.north "tavern"
set courtyard.south "shop"
set courtyard.east "forest"

clone room as shop
set shop.name "General Store"
set shop.description "A cluttered shop filled with supplies and oddities."
set shop.north "courtyard"

clone room as forest
set forest.name "Dark Forest"
set forest.description "Tall trees loom overhead. Shadows dance between the trunks."
set forest.west "courtyard"

print "✓ World created!"
print ""

# Navigate around
print "=== Exploring the World ==="
print ""
print "Going to tavern..."
goto tavern

print "Going to courtyard..."
goto courtyard

print "Going to shop..."
goto shop

print "Going back to courtyard..."
goto courtyard

print "Going to forest..."
goto forest

print ""
print "=== Demo complete! ==="
print ""
print "Try these commands in the REPL:"
print "  goto <room>  - Move to a room"
print "  look         - Look at current room"
print "  properties <object> - Show object properties"
print "  clone <obj> as <new> - Copy an object"
print "  set <obj>.<prop> <value> - Set property (note: 'to' is optional!)"
