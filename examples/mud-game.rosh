# Rosh MUD - Builder Edition
# Complete LPC/TinyMUD-style world with builder commands!

print "=== Loading Rosh MUD Builder ==="
print ""

# === WORLD SETUP ===

# Create rooms
create object tavern
  set name to "The Rusty Tankard Tavern"
  set description to "A cozy tavern with wooden tables and a roaring fireplace. The smell of ale fills the air."
  set north to null
  set south to "courtyard"
  set east to null
  set west to null
end

create object courtyard
  set name to "Village Courtyard"
  set description to "The village courtyard. Cobblestones underfoot. Paths lead in all directions."
  set north to "tavern"
  set south to "shop"
  set east to "forest"
  set west to "well"
end

create object shop
  set name to "General Store"
  set description to "A cluttered shop filled with supplies and oddities."
  set north to "courtyard"
  set south to null
  set east to null
  set west to null
end

create object forest
  set name to "Dark Forest"
  set description to "Tall trees loom overhead. Shadows dance between the trunks."
  set north to null
  set south to null
  set east to null
  set west to "courtyard"
end

create object well
  set name to "The Old Well"
  set description to "An ancient stone well. Water echoes from deep below."
  set north to null
  set south to null
  set east to "courtyard"
  set west to null
end

# Create items with properties
create object sword
  set name to "Rusty Sword"
  set description to "An old but serviceable blade"
  set location to "tavern"
  set portable to true
end

create object gem
  set name to "Mysterious Gem"
  set description to "A crystal that pulses with inner light"
  set location to "forest"
  set portable to true
end

create object potion
  set name to "Health Potion"
  set description to "A red vial that glows faintly"
  set location to "shop"
  set portable to true
end

create object table
  set name to "Heavy Oak Table"
  set description to "A massive wooden table. Too heavy to move."
  set location to "tavern"
  set portable to false
  set fixed to true
end

create object fireplace
  set name to "Stone Fireplace"
  set description to "A roaring fireplace built into the wall."
  set location to "tavern"
  set portable to false
  set fixed to true
end

# Player object
create object player
  set current-room to "tavern"
  set health to 100
  set strength to 10
  set inventory to "empty"
end

# === BUILDER COMMANDS ===

# Look command - shows room + items
define function look
  print "==="

  # Show room description
  if player.current-room is equal to "tavern" then
    print tavern.name
    print tavern.description
  end

  if player.current-room is equal to "courtyard" then
    print courtyard.name
    print courtyard.description
  end

  if player.current-room is equal to "shop" then
    print shop.name
    print shop.description
  end

  if player.current-room is equal to "forest" then
    print forest.name
    print forest.description
  end

  if player.current-room is equal to "well" then
    print well.name
    print well.description
  end

  print ""
  print "Items here:"

  # Check sword
  if sword.location is equal to player.current-room then
    print "  - Rusty Sword (portable)"
  end

  # Check gem
  if gem.location is equal to player.current-room then
    print "  - Mysterious Gem (portable)"
  end

  # Check potion
  if potion.location is equal to player.current-room then
    print "  - Health Potion (portable)"
  end

  # Check table
  if table.location is equal to player.current-room then
    print "  - Heavy Oak Table (fixed)"
  end

  # Check fireplace
  if fireplace.location is equal to player.current-room then
    print "  - Stone Fireplace (fixed)"
  end

  print "==="
end

# Status command
define function status
  print "=== Status ==="
  print "Health:"
  print player.health
  print "Strength:"
  print player.strength
  print "Location:"
  print player.current-room
  print "Carrying:"
  print player.inventory
end

# Inventory command
define function inventory
  print "=== Inventory ==="
  if player.inventory is equal to "empty" then
    print "You're not carrying anything."
  end
  if player.inventory is equal to "sword" then
    print "  - Rusty Sword"
  end
  if player.inventory is equal to "gem" then
    print "  - Mysterious Gem"
  end
  if player.inventory is equal to "potion" then
    print "  - Health Potion"
  end
end

# Take command - pick up items (traditional MUD name)
define function take item
  # Check if sword is here and item is "sword"
  if sword.location is equal to player.current-room then
    if sword.portable is equal to true then
      set sword.location to "inventory"
      set player.inventory to "sword"
      print "You pick up the Rusty Sword."
    end
  end

  # Check gem
  if gem.location is equal to player.current-room then
    if gem.portable is equal to true then
      set gem.location to "inventory"
      set player.inventory to "gem"
      print "You pick up the Mysterious Gem."
    end
  end

  # Check potion
  if potion.location is equal to player.current-room then
    if potion.portable is equal to true then
      set potion.location to "inventory"
      set player.inventory to "potion"
      print "You pick up the Health Potion."
    end
  end
end

# Put command - drop items (avoids "drop" keyword)
define function put item
  # Drop sword
  if player.inventory is equal to "sword" then
    set sword.location to player.current-room
    set player.inventory to "empty"
    print "You drop the Rusty Sword."
  end

  # Drop gem
  if player.inventory is equal to "gem" then
    set gem.location to player.current-room
    set player.inventory to "empty"
    print "You drop the Mysterious Gem."
  end

  # Drop potion
  if player.inventory is equal to "potion" then
    set potion.location to player.current-room
    set player.inventory to "empty"
    print "You drop the Health Potion."
  end
end

# Examine command - detailed look at item
define function examine item
  print "=== Examining ==="

  # Check if examining sword
  if sword.location is equal to player.current-room then
    print sword.name
    print sword.description
    if sword.portable is equal to true then
      print "You could pick this up."
    end
  end

  # Check gem
  if gem.location is equal to player.current-room then
    print gem.name
    print gem.description
    if gem.portable is equal to true then
      print "You could pick this up."
    end
  end

  # Check potion
  if potion.location is equal to player.current-room then
    print potion.name
    print potion.description
    if potion.portable is equal to true then
      print "You could pick this up."
    end
  end

  # Check table
  if table.location is equal to player.current-room then
    print table.name
    print table.description
    if table.fixed is equal to true then
      print "This cannot be moved."
    end
  end

  # Check fireplace
  if fireplace.location is equal to player.current-room then
    print fireplace.name
    print fireplace.description
    if fireplace.fixed is equal to true then
      print "This cannot be moved."
    end
  end
end

# Movement helper - go direction
define function go direction
  print "Moving..."
  # This is a placeholder - user can still use: set player.current-room to "..."
  # Future: could parse direction and update current-room automatically
end

print "=== MUD Ready! ==="
print ""
print "RECOMMENDED ALIASES (type these now):"
print "  alias look call look"
print "  alias status call status"
print "  alias inv call inventory"
print "  alias take call take \"item\""
print "  alias put call put \"item\""
print "  alias examine call examine \"item\""
print "  alias n set player.current-room to \"tavern\""
print "  alias s set player.current-room to \"courtyard\""
print "  alias e set player.current-room to \"forest\""
print "  alias w set player.current-room to \"well\""
print ""
print "AVAILABLE COMMANDS:"
print "  look           - Look around the room"
print "  status         - Check your status"
print "  inv            - Check inventory"
print "  take           - Pick up an item (if portable)"
print "  put            - Drop an item"
print "  examine        - Look closely at an item"
print "  n/s/e/w        - Move between rooms"
print ""
print "BUILDER COMMANDS (advanced):"
print "  create object <name> ... end  - Create new room/item"
print "  set <object>.<property> to <value>  - Modify properties"
print "  dump           - Save entire world state"
print "  load \"file.json\" - Load world state"
print ""
print "Try: look"
