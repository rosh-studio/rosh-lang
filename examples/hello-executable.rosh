#!/usr/bin/env rosh
# Demo executable Rosh script
# After pip install, make this executable:
#   chmod +x hello-executable.rosh
#   ./hello-executable.rosh
ex
print "=== Hello from Executable Rosh Script ==="

create string name to "World"
print "Hello, "
print name
print "!"

create number roll to random 1 to 6
print "You rolled a"
print roll

print "Script complete!"
