# MUD with Alias Demo
# Shows how to use aliases for natural command shortcuts

import "examples/mud-game.rosh"

print ""
print "=== Alias Demo ==="
print ""
print "In REPL, try these:"
print ""
print "# Create shortcuts"
print "alias look call look"
print "alias l call look"
print "alias status call status"
print "alias s call status"
print ""
print "# Movement shortcuts"
print "alias north set player.current-room to \"tavern\""
print "alias south set player.current-room to \"courtyard\""
print "alias n set player.current-room to \"tavern\""
print "alias s set player.current-room to \"courtyard\""
print "alias e set player.current-room to \"forest\""
print "alias w set player.current-room to \"well\""
print ""
print "# Then just type:"
print "  look    (instead of 'call look')"
print "  l       (even shorter!)"
print "  north   (move north)"
print "  n       (go north)"
print ""
print "# List all aliases:"
print "  alias"
print ""
print "=== Now you have a real MUD interface! ==="
