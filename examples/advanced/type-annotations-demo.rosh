# ========================================
# TYPE ANNOTATIONS DEMONSTRATION
# ========================================
# Shows how type annotations work in Rosh v0.0.6

print "=== Type Annotations Demo ==="
print ""

# ========================================
# 1. TYPE INFERENCE (No annotations)
# ========================================
print "1. Type Inference (automatic):"
create x to 42
create name to "Alice"
create scores to [95, 87, 92]

print "x = "
print x
print "name = "
print name
print "scores = "
print scores
print ""

# ========================================
# 2. SIMPLE TYPE ANNOTATIONS
# ========================================
print "2. Simple Type Annotations:"
create age: number to 25
create greeting: string to "Hello"
create active: boolean to true

print "age (number) = "
print age
print "greeting (string) = "
print greeting
print "active (boolean) = "
print active
print ""

# ========================================
# 3. LIST TYPE ANNOTATIONS
# ========================================
print "3. List Type Annotations:"
create numbers: list<number> to [1, 2, 3, 4, 5]
create words: list<string> to ["apple", "banana", "cherry"]

print "numbers (list<number>) = "
print numbers
print "words (list<string>) = "
print words
print ""

# ========================================
# 4. EMPTY LISTS WITH ANNOTATIONS
# ========================================
print "4. Empty Lists (annotations document intent):"
create inventory: list<string> to []
create high_scores: list<number> to []

print "Empty inventory (list<string>) = "
print inventory

append "sword" to inventory
append "shield" to inventory
print "After appending strings:"
print inventory
print ""

# ========================================
# 5. WHY USE TYPE ANNOTATIONS?
# ========================================
print "5. Benefits of Type Annotations:"
print ""
print "✓ Self-documenting code"
print "  create health: number to 100"
print "  ^ Clear that health is numeric"
print ""
print "✓ Catch errors early"
print "  create count: number to 'five'"
print "  ^ Type error at creation, not later!"
print ""
print "✓ IDE support"
print "  - Autocomplete knows types"
print "  - Error highlighting"
print "  - Hover tooltips"
print ""
print "✓ Empty collections"
print "  create items: list<string> to []"
print "  ^ Documents what goes in the list"
print ""

# ========================================
# 6. WHEN TO USE ANNOTATIONS
# ========================================
print "6. When to Use Annotations:"
print ""
print "USE annotations for:"
print "  • Empty collections"
print "  • Function parameters (coming soon)"
print "  • Public APIs"
print "  • Complex data structures"
print ""
print "SKIP annotations when:"
print "  • Type is obvious from value"
print "  • Quick prototyping"
print "  • Internal/temporary variables"
print ""

print "=== Demo Complete ==="
