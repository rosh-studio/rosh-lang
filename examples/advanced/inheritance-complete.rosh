# Complete Inheritance Example
# From your approved design - the full paladin scenario!

# Base character class
create object character
  set health to 100
  set mana to 50
end

# Warrior - inherits from character
create object warrior from character
  set strength to 10
end

# Healer - separate class
create object healer
  set healing to 20
end

# Paladin - multiple inheritance!
create object paladin from warrior, healer
  set armor to 15
end

print "=== Paladin Properties ==="
print "Health (from character via warrior):"
print paladin.health
print "Mana (from character via warrior):"
print paladin.mana
print "Strength (from warrior):"
print paladin.strength
print "Healing (from healer):"
print paladin.healing
print "Armor (own property):"
print paladin.armor

print ""
print "=== Property Stack Demo ==="
print "Base health:"
print paladin.health

# Battle buff!
push paladin.health 150
print "After buff (push 150):"
print paladin.health

# Mega buff!
push paladin.health 200
print "After mega buff (push 200):"
print paladin.health

# Buff expires
pop paladin.health
print "Mega buff expired (pop):"
print paladin.health

# First buff expires
pop paladin.health
print "All buffs expired (back to base):"
print paladin.health

# Permanent upgrade
set paladin.health to 250
print "Permanent upgrade (set to 250):"
print paladin.health
