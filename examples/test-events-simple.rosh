#!/usr/bin/env rosh
# ============================================
# SIMPLE EVENT SYSTEM TEST
# ============================================
# Quick validation that events work correctly
#
# Run: rosh examples/test-events-simple.rosh
#
# Expected output:
# - All tests should print "✓ PASS"
# - No errors should occur
# ============================================

print "=== SIMPLE EVENT SYSTEM TESTS ==="
print ""

# ────────────────────────────────────────────
# TEST 1: Basic event (no parameters)
# ────────────────────────────────────────────
print "TEST 1: Basic event (no parameters)"

set test1_fired to false

when simple_event then
    set test1_fired to true
end

trigger simple_event

if test1_fired is equal to true then
    print "✓ PASS: Event fired successfully"
else
    print "✗ FAIL: Event did not fire"
end
print ""

# ────────────────────────────────────────────
# TEST 2: Event with parameters
# ────────────────────────────────────────────
print "TEST 2: Event with parameters"

set test2_value to 0

when add_numbers a b then
    set test2_value to a plus b
end

trigger add_numbers with 10 20

if test2_value is equal to 30 then
    print "✓ PASS: Parameters passed correctly (10 + 20 = 30)"
else
    print "✗ FAIL: Expected 30, got {test2_value}"
end
print ""

# ────────────────────────────────────────────
# TEST 3: Multiple handlers for same event
# ────────────────────────────────────────────
print "TEST 3: Multiple handlers for same event"

set test3_count to 0

when multi_event then
    set test3_count to test3_count plus 1
end

when multi_event then
    set test3_count to test3_count plus 1
end

when multi_event then
    set test3_count to test3_count plus 1
end

trigger multi_event

if test3_count is equal to 3 then
    print "✓ PASS: All 3 handlers executed"
else
    print "✗ FAIL: Expected 3, got {test3_count}"
end
print ""

# ────────────────────────────────────────────
# TEST 4: Nested events (event triggering event)
# ────────────────────────────────────────────
print "TEST 4: Nested events"

set test4_step1 to false
set test4_step2 to false

when outer then
    set test4_step1 to true
    trigger inner
end

when inner then
    set test4_step2 to true
end

trigger outer

if test4_step1 is equal to true and test4_step2 is equal to true then
    print "✓ PASS: Nested events work (outer → inner)"
else
    print "✗ FAIL: Nested events failed"
end
print ""

# ────────────────────────────────────────────
# TEST 5: Events with objects
# ────────────────────────────────────────────
print "TEST 5: Events with objects"

create object test_player
    set health to 100
end

when damage target amount then
    set target.health to target.health minus amount
end

trigger damage with test_player 25

if test_player.health is equal to 75 then
    print "✓ PASS: Object modification works (100 - 25 = 75)"
else
    print "✗ FAIL: Expected 75, got {test_player.health}"
end
print ""

# ────────────────────────────────────────────
# TEST 6: Event with no handlers (should not error)
# ────────────────────────────────────────────
print "TEST 6: Triggering nonexistent event"

trigger this_event_has_no_handlers

print "✓ PASS: No error when triggering event with no handlers"
print ""

# ────────────────────────────────────────────
# TEST 7: Event with insufficient arguments
# ────────────────────────────────────────────
print "TEST 7: Insufficient arguments (should bind to null)"

set test7_a to 999
set test7_b to 999
set test7_c to 999

when three_params a b c then
    set test7_a to a
    set test7_b to b
    set test7_c to c
end

trigger three_params with 1 2  # Missing third argument

if test7_a is equal to 1 and test7_b is equal to 2 and test7_c is equal to null then
    print "✓ PASS: Missing arguments bound to null (a=1, b=2, c=null)"
else
    print "✗ FAIL: Arguments not bound correctly"
end
print ""

# ────────────────────────────────────────────
# TEST 8: String interpolation in events
# ────────────────────────────────────────────
print "TEST 8: String interpolation with event parameters"

set test8_message to ""

when greet name then
    set test8_message to "Hello {name}!"
end

trigger greet with "World"

if test8_message is equal to "Hello World!" then
    print "✓ PASS: String interpolation works in handlers"
else
    print "✗ FAIL: Expected 'Hello World!', got '{test8_message}'"
end
print ""

# ────────────────────────────────────────────
# SUMMARY
# ────────────────────────────────────────────
print "=========================================="
print "         ALL TESTS COMPLETED"
print "=========================================="
print ""
print "If all tests show ✓ PASS, the event system"
print "is working correctly!"
print ""
print "Event features tested:"
print "  ✓ Basic event registration and triggering"
print "  ✓ Parameter passing"
print "  ✓ Multiple handlers per event"
print "  ✓ Nested events"
print "  ✓ Object modification"
print "  ✓ Graceful handling of missing handlers"
print "  ✓ Null binding for missing arguments"
print "  ✓ String interpolation"
print ""
