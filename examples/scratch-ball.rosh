background "sky blue"
sound pop "short pop"
create object ball
set ball.shape to circle
set ball.color to red
set ball.x to center
set ball.y to middle
set ball.draggable to true
set ball.volume to 0.5
use controller target ball keys arrows speed 0.03 move x help off
create object gem
set gem.shape to gem
set gem.color to purple
set gem.x to right
set gem.y to top

when start
  set ball.layer to front
  say "hello Scratch"
end

when click ball
  say "you clicked the ball"
  play pop
end

when collision ball gem
  say "collected"
  play pop
  destroy gem
end

when keydown space
  set ball.y to ball.y - 0.1
  play pop
end

when keydown h
  set ball.visible to false
end

when keydown s
  set ball.visible to true
end
