# AI prompt with context example
# Demonstrates passing Rosh variables to the AI

create object player
  set name to "Hero"
  set health to 75
  set level to 5
  set gold to 150
end

create quest_status to "searching for ancient artifact"

print "Player stats created. Asking AI for advice..."

prompt "Based on the player's current status, give a brief suggestion for their next action" using player quest_status into advice

print "AI Advice:"
print advice
