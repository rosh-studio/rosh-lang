# Object Management Demo
# Demonstrates clone, delete, and properties commands

print "=== Rosh Object Management Demo ==="
print ""

# 1. Create a base weapon template
print "Creating weapon template..."
create object weapon-template
  set type to "weapon"
  set durability to 100
  set value to 10
end

# 2. Show its properties
print ""
properties weapon-template

# 3. Clone it to create specific weapons
print ""
print "Cloning weapons from template..."
clone weapon-template as sword
set sword.name to "Iron Sword"
set sword.damage to 25

clone weapon-template as bow
set bow.name to "Wooden Bow"
set bow.damage to 15
set bow.range to 50

clone weapon-template as dagger
set dagger.name to "Steel Dagger"
set dagger.damage to 18
set dagger.speed to "fast"

# 4. Show properties of each
print ""
print "Sword properties:"
properties sword

print ""
print "Bow properties:"
properties bow

print ""
print "Dagger properties:"
properties dagger

# 5. Create a magical version
print ""
print "Creating magical sword variant..."
clone sword as flaming-sword
set flaming-sword.name to "Flaming Sword"
set flaming-sword.damage to 50
set flaming-sword.enchantment to "fire"

print ""
properties flaming-sword

# 6. Delete the template (no longer needed)
print ""
print "Deleting weapon-template (no longer needed)..."
delete weapon-template

print ""
print "=== Demo complete! ==="
print "Remaining weapons: sword, bow, dagger, flaming-sword"
