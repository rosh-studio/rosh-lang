# Factorial Calculator using While Loop
# Calculates n! = n × (n-1) × (n-2) × ... × 1

create n to 5
create result to 1
create i to 1

print "Calculating factorial of"
print n

while i is below n plus 1 then
  set result to result times i
  set i to i plus 1
end

print "Result:"
print result
print "(5! = 120)"
