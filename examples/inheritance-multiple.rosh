# Multiple Inheritance Example
# Test: left-to-right resolution

create object character
  set health to 100
  set mana to 50
end

create object healer
  set healing to 20
  set mana to 100
end

# paladin inherits from both (warrior first, healer second)
# Should get mana=50 from character (not 100 from healer)
create object paladin from character, healer
  set armor to 15
end

print "Paladin health (from character):"
print paladin.health
print "Paladin mana (from character, NOT healer):"
print paladin.mana
print "Paladin healing (from healer):"
print paladin.healing
print "Paladin armor (own):"
print paladin.armor
