# demo: Mini Game
# description: Shoot or catch the falling ball — arrow keys move, space to fire
# badges: Keyboard, Velocity, Game Loop

set _max_output to 3

create object player
set player.x to 0.4
set player.y to 0.8
set player.width to 0.12
set player.height to 0.05
set player.color to "#e94560"
sprite player "red spaceship"

create object ball
set ball.x to 0.45
set ball.y to 0.05
set ball.width to 0.06
set ball.height to 0.06
set ball.color to "#2ecc71"
sprite ball "green orb"

use bullet count 3
use explosion count 3

create number score
set score to 0

sound catch "coin collect"

on update when ball.y > 1 set ball.y to 0.05

print "Arrows move, Space shoots!"

when keydown ArrowLeft
  set player.x to player.x - 0.05
end

when keydown ArrowRight
  set player.x to player.x + 0.05
end

# Space fires the bullet from the player
when keydown " "
  set bullet._x to player.x + 0.05
  set bullet._y to 0.75
  set bullet._fire to 1
  play bullet.pew
end

when update
  set ball.y to ball.y + 0.003
end

when collision player ball
  play catch
  set score to score + 1
  set ball.y to 0.05
  set player.x to 0.4
  print "Catch #{score}!"
end

# Wildcard — any bullet hitting the ball scores + explosion
when collision bullet.* ball
  set explosion._x to ball.x
  set explosion._y to ball.y
  set explosion._fire to 1
  play explosion.boom
  set score to score + 2
  set ball.y to 0.05
  print "Shot! +2 = {score}"
end
