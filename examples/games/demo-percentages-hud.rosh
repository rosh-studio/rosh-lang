# =============================================================================
# Percentage Positioning + HUD Demo
# =============================================================================
#
# WHAT THIS DEMONSTRATES:
# - Percentage-based positioning (50% = center, responsive layout)
# - Explicit HUD creation (set target to hero)
# - HUD automatically displays lives and score from target
# - Fixed objects (chest won't move)
#
# HOW TO RUN:
#   rosh build examples/games/demo-percentages-hud.rosh --target phaser --output dist/
#
# Then open dist/index.html in your web browser
#
# CONTROLS:
# - Arrow keys: Move hero
# - Space bar: Increase score by 50
# - Watch the HUD in top-left update automatically!
#
# PERCENTAGE POSITIONING:
# - 50% = center of screen (400, 300 on 800x600 canvas)
# - 25% = top-left quadrant (200, 150)
# - 75% = bottom-right quadrant (600, 450)
# - 2% = small offset from edge (16, 12)
#
# =============================================================================

# Hero at center using percentages
create object hero from player
    set x to 50%
    set y to 50%
    set lives to 3
    set score to 0
end

# Enemy at top-left quadrant
create object enemy
    set x to 25%
    set y to 25%
end

# Chest at bottom-right
create object chest
    set x to 75%
    set y to 75%
    set fixed to true
end

# HUD in top-left corner
create object hud
    set target to hero
    set x to 2%
    set y to 2%
end

# Score points when firing
when fire then
    set hero.score to hero.score plus 50
    print "Score: {hero.score}"
end

print "=== Percentage + HUD Demo ==="
print "Hero at 50% = center (400, 300)"
print "Enemy at 25% = (200, 150)"
print "Chest at 75% = (600, 450)"
print "HUD at 2% = (16, 12)"
print "Arrow keys to move, Space to score!"
