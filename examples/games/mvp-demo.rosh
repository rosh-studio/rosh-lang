# =============================================================================
# MVP Demo: Complete Game Features Showcase
# =============================================================================
#
# WHAT THIS DEMONSTRATES:
# - Percentage positioning (50% = center of screen)
# - Explicit HUD creation (lives and score display)
# - Edge behavior (wrap_edges: true/false)
# - Collision detection (multiple collision handlers)
# - Property mutations in event handlers
# - String interpolation in print statements
#
# HOW TO RUN:
#   rosh build examples/games/mvp-demo.rosh --target phaser --output dist/
#
# Then open dist/index.html in your web browser
#
# CONTROLS:
# - Arrow keys: Move hero
# - Avoid the red enemy (decreases lives)
# - Collect the green coin (increases score)
# - Watch the HUD in top-left corner for lives/score
#
# =============================================================================

# Hero at center with edge clamping (stops at boundaries)
create object hero from player
    set x to 50%
    set y to 50%
    set lives to 3
    set score to 0
    set wrap_edges to false
end

# Enemy at top-right
create object enemy
    set x to 75%
    set y to 25%
end

# Coin at bottom-left
create object coin
    set x to 25%
    set y to 75%
    set fixed to true
end

# HUD in top-left
create object hud
    set target to hero
    set x to 2%
    set y to 2%
end

# Collision with enemy decreases lives
when collision hero enemy then
    set hero.lives to hero.lives minus 1
    print "Ouch! Lives: {hero.lives}"
end

# Collision with coin increases score
when collision hero coin then
    set hero.score to hero.score plus 100
    print "Got coin! Score: {hero.score}"
end

print "=== MVP DEMO ==="
print "Arrow keys to move (wraps at edges!)"
print "Avoid enemy, collect coin"
print "Watch HUD for lives and score"
