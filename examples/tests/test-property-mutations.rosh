# Test property mutations in events (Phase 7)
create object hero from player
    set x to 400
    set y to 300
    set lives to 5
    set score to 0
end

# Decrease lives when fire (space bar)
when fire then
    set hero.lives to hero.lives minus 1
    set hero.score to hero.score plus 10
    print "Lives: {hero.lives}, Score: {hero.score}"
end

print "Press space to decrease lives and increase score"
