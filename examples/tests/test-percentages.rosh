# Test percentage positioning
#
# In Rosh, coordinates are ALWAYS percentages by default:
#   set x to 50       # 50% (bare number = percentage)
#   set x to 50%      # 50% (explicit percentage, same result)
#   set x to 400px    # Exactly 400 pixels (explicit pixels, rare)
#
# This makes code work across any canvas size!

# Hero at center (bare numbers = percentages)
create object hero from player
    set x to 50       # 50% = center
    set y to 50       # 50% = center
end

# Top-left using explicit % (same as bare number)
create object top_left
    set x to 10%
    set y to 10%
end

# Bottom-right using bare numbers
create object bottom_right
    set x to 90       # 90% = near right edge
    set y to 90       # 90% = near bottom
end

# Explicit pixels (rare, for pixel-perfect positioning)
create object pixel_positioned
    set x to 100px    # Exactly 100 pixels from left
    set y to 75px     # Exactly 75 pixels from top
end

print "Hero at center: set x to 50 = 50%"
print "Top-left: set x to 10% = 10%"
print "Bottom-right: set x to 90 = 90%"
print "Pixel object: set x to 100px = 100 pixels"
