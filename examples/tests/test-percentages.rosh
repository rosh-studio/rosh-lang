# Test percentage positioning
create object hero from player
    set x to 50%
    set y to 50%
end

create object top_left
    set x to 10%
    set y to 10%
end

create object bottom_right
    set x to 90%
    set y to 90%
end

print "Hero at center (50%, 50%) = (400, 300)"
print "Top-left at (10%, 10%) = (80, 60)"
print "Bottom-right at (90%, 90%) = (720, 540)"
