# Test explicit HUD creation
create object hero from player
    set x to 50%
    set y to 50%
    set lives to 5
    set score to 0
end

# Create HUD explicitly (object with target property)
create object hero_hud
    set target to hero
    set x to 10
    set y to 10
end

# Test score updates
when fire then
    set hero.score to hero.score plus 100
    print "Score: {hero.score}"
end

print "Hero with explicit HUD at (10, 10)"
print "Press space to score points"
