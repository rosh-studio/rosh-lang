# Test collision detection
create object hero from player
    set x to 50%
    set y to 50%
    set lives to 3
end

create object enemy
    set x to 55%
    set y to 50%
end

create object hud
    set target to hero
    set x to 10
    set y to 10
end

# Collision handler
when collision hero enemy then
    set hero.lives to hero.lives minus 1
    print "Ouch! Lives: {hero.lives}"
end

print "Move hero into enemy to test collision"
print "Lives will decrease on hit"
