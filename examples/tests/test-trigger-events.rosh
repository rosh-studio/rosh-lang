# Test trigger statements with parameters (Phase 8)
create object hero from player
    set x to 400
    set y to 300
    set lives to 5
end

# Handler that receives damage parameter
when damage then
    set hero.lives to hero.lives minus 1
    print "Hero took damage! Lives: {hero.lives}"
end

# Handler for game over
when game_over then
    print "Game Over!"
end

# Trigger damage event with parameter (simulated)
when fire then
    trigger damage with 1
    print "Triggered damage event"
end

print "Press space to trigger damage event"
