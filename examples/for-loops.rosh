# For Loop Examples in Rosh
# Demonstrates the different types of for loops

print "=== Example 1: Basic Range Loop ==="
print "Counting from 1 to 5:"
for i in 1 to 5 then
    print i
end

print ""
print "=== Example 2: Range with Step ==="
print "Odd numbers from 1 to 10:"
for i in 1 to 10 step 2 then
    print i
end

print ""
print "=== Example 3: Calculate Sum ==="
create number total to 0
for i in 1 to 10 then
    set total to total plus i
end
print "Sum of numbers 1 to 10:"
print total

print ""
print "=== Example 4: Multiplication Table ==="
print "3 times table:"
for i in 1 to 5 then
    create number result to i times 3
    print result
end

print ""
print "=== Example 5: Nested Loops ==="
print "Simple pattern:"
for row in 1 to 3 then
    print "Row:"
    for col in 1 to 4 then
        print col
    end
end

print ""
print "=== Example 6: Iterating Over Object Instances ==="
# Create a template
create object item
    create string name to "Item"
    create number value to 0
end

# Create instances
clone item as sword
set sword.name to "Iron Sword"
set sword.value to 100

clone item as shield
set shield.name to "Wooden Shield"
set shield.value to 50

clone item as potion
set potion.name to "Health Potion"
set potion.value to 25

print "Inventory:"
for obj in all item then
    print "- "
    get obj.name
    print
    print "  Value: "
    get obj.value
    print
end

print ""
print "For loops complete!"
