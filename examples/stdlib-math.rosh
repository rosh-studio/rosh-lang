# Built-in Math Functions Demo
# These are NATIVE functions - implemented in Python for speed!

print "=== Basic Math ==="

call sqrt 16
print "sqrt(16) ="
print

call pow 2 8
print "pow(2, 8) ="
print

call abs 42
print "abs(42) ="
print

print ""
print "=== Min/Max ==="

call min 5 3 9 1
print "min(5, 3, 9, 1) ="
print

call max 5 3 9 1
print "max(5, 3, 9, 1) ="
print

print ""
print "=== Rounding ==="

call floor 3.7
print "floor(3.7) ="
print

call ceil 3.2
print "ceil(3.2) ="
print

call round 3.5
print "round(3.5) ="
print

print ""
print "=== Trigonometry (radians) ==="

call cos 0
print "cos(0) ="
print

print ""
print "=== Random ==="

call random
print "random() [0-1] ="
print

call randint 1 100
print "randint(1, 100) ="
print

print ""
print "=== Combining with Stack ==="
call sqrt 25
print "sqrt(25) pushed to stack, then print:"
print
