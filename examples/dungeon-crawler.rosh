#!/usr/bin/env rosh
# ============================================
# DUNGEON CRAWLER - Interactive MUD Demo
# ============================================
# Updated for Rosh v0.0.6 with:
# - String interpolation
# - User input command
# - else if syntax
# - NOT in compound expressions
#
# A full-featured dungeon crawler demonstrating:
# - 6 interconnected rooms
# - Turn-based combat system
# - Inventory management
# - NPCs (merchant, enemies)
# - Items (weapons, armor, potions)
# - Quest system (collect 3 gems)
# - Win/lose conditions
# - Score tracking
#
# Run with: rosh examples/dungeon-crawler.rosh
# ============================================

print "============================================"
print "     DUNGEON CRAWLER - A Rosh MUD"
print "     Now with v0.0.6 features!"
print "============================================"
print ""
print "Commands: north/n, south/s, east/e, west/w"
print "          look/examine/l, inventory/inv/i, status"
print "          get/take/pickup, attack/fight, drink/use potion"
print "          talk, buy <item>, wear/equip armor, quit"
print "============================================"
print ""

# ============================================
# GAME STATE
# ============================================

# Player character
create object player
    set name to "Adventurer"
    set health to 100
    set max_health to 100
    set attack to 10
    set defense to 5
    set gold to 50
    set score to 0
    set current_room to "entrance"
    set inventory to []
    set has_sword to false
    set has_armor to false
    set gems_collected to 0
end

# Game state
create object game
    set running to true
    set turns to 0
    set combat_active to false
    set current_enemy to null
end

# ============================================
# ROOMS
# ============================================

create object entrance
    set name to "Entrance Hall"
    set description to "A grand entrance hall with torches on the walls."
    set north to "armory"
    set east to "marketplace"
    set south to ""
    set west to ""
    set visited to false
    set has_item to false
    set has_enemy to false
end

create object armory
    set name to "Armory"
    set description to "An old armory with weapon racks. A sword lies on the ground."
    set north to ""
    set east to ""
    set south to "entrance"
    set west to "treasure_room"
    set visited to false
    set has_item to true
    set item_name to "Iron Sword"
    set item_type to "weapon"
    set has_enemy to false
end

create object marketplace
    set name to "Marketplace"
    set description to "A deserted marketplace. A merchant stands in the corner."
    set north to "dungeon"
    set east to ""
    set south to ""
    set west to "entrance"
    set visited to false
    set has_item to false
    set has_merchant to true
    set has_enemy to false
end

create object dungeon
    set name to "Dark Dungeon"
    set description to "A damp dungeon. Water drips from the ceiling. You sense danger!"
    set north to ""
    set east to "boss_chamber"
    set south to "marketplace"
    set west to ""
    set visited to false
    set has_item to true
    set item_name to "Health Potion"
    set item_type to "potion"
    set has_enemy to true
    set enemy_name to "Goblin"
end

create object boss_chamber
    set name to "Boss Chamber"
    set description to "A huge chamber with a throne. The Dragon Lord awaits!"
    set north to ""
    set east to ""
    set south to ""
    set west to "dungeon"
    set visited to false
    set has_item to true
    set item_name to "Ruby Gem"
    set item_type to "gem"
    set has_enemy to true
    set enemy_name to "Dragon Lord"
    set is_boss to true
end

create object treasure_room
    set name to "Treasure Room"
    set description to "A glittering room filled with gold and jewels!"
    set north to ""
    set east to "armory"
    set south to ""
    set west to ""
    set visited to false
    set has_item to true
    set item_name to "Sapphire Gem"
    set item_type to "gem"
    set locked to true
    set has_enemy to false
end

# ============================================
# ENEMIES
# ============================================

create object goblin_template
    set name to "Goblin"
    set health to 30
    set max_health to 30
    set attack to 8
    set defense to 3
    set gold_drop to 20
    set score_value to 50
end

create object dragon_template
    set name to "Dragon Lord"
    set health to 100
    set max_health to 100
    set attack to 20
    set defense to 10
    set gold_drop to 100
    set score_value to 500
end

# ============================================
# HELPER FUNCTIONS
# ============================================

define function get_room room_name
    if room_name is equal to "entrance" then
        return entrance
    else if room_name is equal to "armory" then
        return armory
    else if room_name is equal to "marketplace" then
        return marketplace
    else if room_name is equal to "dungeon" then
        return dungeon
    else if room_name is equal to "boss_chamber" then
        return boss_chamber
    else if room_name is equal to "treasure_room" then
        return treasure_room
    end
    return null
end

define function describe_room room
    print "----------------------------------------"
    print room.name
    print "----------------------------------------"
    print room.description

    # Show exits using string interpolation!
    set exits to ""
    if not room.north is equal to "" then
        set exits to exits plus "north "
    end
    if not room.east is equal to "" then
        set exits to exits plus "east "
    end
    if not room.south is equal to "" then
        set exits to exits plus "south "
    end
    if not room.west is equal to "" then
        set exits to exits plus "west "
    end

    if not exits is equal to "" then
        print "Exits: {exits}"
    end

    # Show items
    if room.has_item then
        print "You see: {room.item_name}"
    end

    # Show merchant
    if room.has_merchant then
        print "A merchant is here. (Use 'talk' to speak)"
    end

    # Check for enemies (but don't trigger combat automatically)
    if room.has_enemy and not room.visited then
        print "There's a {room.enemy_name} here!"
    end

    print ""
end

define function show_status
    print "========== STATUS =========="
    print "Name: {player.name}"
    print "Health: {player.health}/{player.max_health}"
    print "Attack: {player.attack} | Defense: {player.defense}"
    print "Gold: {player.gold}"
    print "Score: {player.score}"
    print "Gems: {player.gems_collected}/3"
    print "============================"
    print ""
end

define function show_inventory
    print "========== INVENTORY =========="
    if player.has_sword then
        print "- Iron Sword (+5 attack)"
    end
    if player.has_armor then
        print "- Chain Armor (+5 defense)"
    end

    # Show potions
    set potion_count to 0
    for item in player.inventory then
        if item is equal to "Health Potion" then
            set potion_count to potion_count plus 1
        end
    end

    if potion_count is above 0 then
        print "- Health Potion x{potion_count}"
    end

    if player.inventory contains "Ruby Gem" then
        print "- Ruby Gem"
    end
    if player.inventory contains "Sapphire Gem" then
        print "- Sapphire Gem"
    end
    if player.inventory contains "Emerald Gem" then
        print "- Emerald Gem"
    end

    print "==============================="
    print ""
end

define function start_combat enemy_name
    set game.combat_active to true

    # Clone enemy template
    if enemy_name is equal to "Goblin" then
        clone goblin_template as current_enemy
        set game.current_enemy to current_enemy
    else if enemy_name is equal to "Dragon Lord" then
        clone dragon_template as current_enemy
        set game.current_enemy to current_enemy
    end

    print "Combat started with {game.current_enemy.name}!"
    print "Enemy Health: {game.current_enemy.health}/{game.current_enemy.max_health}"
    print "(Use 'attack' to fight)"
    print ""
end

define function combat_turn
    if not game.combat_active then
        print "No combat active!"
        return
    end

    # Player attacks
    set damage to player.attack minus game.current_enemy.defense
    if damage is below 1 then
        set damage to 1
    end

    set game.current_enemy.health to game.current_enemy.health minus damage
    print "You attack for {damage} damage!"

    # Check if enemy died
    if game.current_enemy.health is below 1 then
        print "You defeated the {game.current_enemy.name}!"
        set player.gold to player.gold plus game.current_enemy.gold_drop
        set player.score to player.score plus game.current_enemy.score_value
        print "Gained {game.current_enemy.gold_drop} gold and {game.current_enemy.score_value} score!"

        # Boss victory?
        if game.current_enemy.name is equal to "Dragon Lord" then
            print ""
            print "============================================"
            print "     CONGRATULATIONS!"
            print "============================================"
            print "You have defeated the Dragon Lord!"
            print "Final Score: {player.score}"
            print "Gems Collected: {player.gems_collected}/3"
            print "Gold: {player.gold}"
            print "============================================"
            set game.running to false
        end

        set game.combat_active to false
        print ""
        return
    end

    # Enemy attacks back
    set enemy_damage to game.current_enemy.attack minus player.defense
    if enemy_damage is below 1 then
        set enemy_damage to 1
    end

    set player.health to player.health minus enemy_damage
    print "The {game.current_enemy.name} attacks for {enemy_damage} damage!"
    print "Your health: {player.health}/{player.max_health}"

    # Check if player died
    if player.health is below 1 then
        print ""
        print "============================================"
        print "     GAME OVER"
        print "============================================"
        print "You have been defeated!"
        print "Final Score: {player.score}"
        print "============================================"
        set game.running to false
    end

    print ""
end

define function pickup_item room
    if not room.has_item then
        print "Nothing to pick up here."
        return
    end

    # Weapon
    if room.item_type is equal to "weapon" then
        set player.has_sword to true
        set player.attack to player.attack plus 5
        print "Picked up {room.item_name}! Attack +5"
        set room.has_item to false
    else if room.item_type is equal to "potion" then
        append "Health Potion" to player.inventory
        print "Picked up {room.item_name}!"
        set room.has_item to false
    else if room.item_type is equal to "gem" then
        append room.item_name to player.inventory
        set player.gems_collected to player.gems_collected plus 1
        set player.score to player.score plus 100
        print "Picked up {room.item_name}! Gems: {player.gems_collected}/3"
        set room.has_item to false

        # Unlock treasure room if all gems collected
        if player.gems_collected is equal to 3 then
            print "You have all 3 gems! The treasure room unlocks!"
            set treasure_room.locked to false
        end
    end

    print ""
end

define function use_potion
    # Check if player has potion
    set has_potion to false
    for item in player.inventory then
        if item is equal to "Health Potion" then
            set has_potion to true
        end
    end

    if not has_potion then
        print "No potions in inventory!"
        return
    end

    # Use potion
    set heal_amount to 50
    set player.health to player.health plus heal_amount
    if player.health is above player.max_health then
        set player.health to player.max_health
    end

    remove "Health Potion" from player.inventory
    print "Used Health Potion! Healed {heal_amount} HP."
    print "Health: {player.health}/{player.max_health}"
    print ""
end

define function talk_to_merchant
    print "Merchant: 'Welcome! I sell fine armor and potions.'"
    print "- Chain Armor: 30 gold (+5 defense)"
    print "- Health Potion: 15 gold (heals 50 HP)"
    print "(Use 'buy armor' or 'buy potion')"
    print ""
end

define function buy_item item_name
    if item_name is equal to "armor" then
        if player.has_armor then
            print "You already have armor!"
            return
        end
        if player.gold is below 30 then
            print "Not enough gold! Need 30."
            return
        end
        set player.gold to player.gold minus 30
        set player.has_armor to true
        set player.defense to player.defense plus 5
        print "Bought Chain Armor! Defense +5"
    else if item_name is equal to "potion" then
        if player.gold is below 15 then
            print "Not enough gold! Need 15."
            return
        end
        set player.gold to player.gold minus 15
        append "Health Potion" to player.inventory
        print "Bought Health Potion!"
    end
    print "Gold remaining: {player.gold}"
    print ""
end

# ============================================
# MAIN GAME LOOP
# ============================================

# Get starting room
set current_room to call get_room player.current_room
call describe_room current_room

# Main game loop with INPUT command!
while game.running then
    set game.turns to game.turns plus 1

    # Get player input with inline prompt!
    input command prompt "> "

    # Clean up command: trim whitespace and lowercase
    set command to trim command
    set command to lowercase of command

    # Strip common filler words for better natural language understanding
    # Remove "the", "a", "an", "at", "to", "with" to normalize commands
    # Example: "talk to merchant" -> "talk merchant", "examine the sword" -> "examine sword"

    # Replace " the " with " "
    if command contains " the " then
        # Split by " the " and join
        set parts to split command by " the "
        set command to ""
        set first to true
        for part in parts then
            if first then
                set command to part
                set first to false
            else
                set command to command plus " " plus part
            end
        end
    end

    # Remove " a ", " an ", " at ", " to ", " with "
    set filler_words to ["a", "an", "at", "to", "with"]
    for filler in filler_words then
        set search_term to " " plus filler plus " "
        if command contains search_term then
            set parts to split command by search_term
            set command to ""
            set first to true
            for part in parts then
                if first then
                    set command to part
                    set first to false
                else
                    set command to command plus " " plus part
                end
            end
        end
    end

    # Trim again after stripping filler words
    set command to trim command

    # Parse command using else if!
    if command is equal to "quit" or command is equal to "exit" then
        print "Thanks for playing!"
        set game.running to false

    else if command is equal to "look" or command is equal to "examine" or command is equal to "inspect" or command is equal to "l" or command is equal to "ex" or command contains "look " or command contains "examine " or command contains "inspect " or command contains "l " or command contains "ex " then
        # Check if examining a specific item
        if command contains "sword" then
            if player.has_sword then
                print "A fine iron sword. Attack +5."
                print "You're wielding it proudly."
                print ""
            else if current_room.has_item and current_room.item_type is equal to "weapon" then
                print "A fine iron sword lies on the ground."
                print "It looks sharp and well-maintained. Attack +5."
                print "(Use 'get sword' to pick it up)"
                print ""
            else
                print "You don't see a sword here."
                print ""
            end
        else if command contains "armor" then
            if player.has_armor then
                print "Sturdy chain armor. Defense +5."
                print ""
            else
                print "You don't have any armor yet."
                print ""
            end
        else if command contains "potion" then
            print "Health potions restore 50 HP when used."
            print ""
        else if command contains "merchant" then
            if current_room.has_merchant then
                print "A friendly merchant selling armor and potions."
                print ""
            else
                print "No merchant here."
                print ""
            end
        else
            # Just look at the room
            call describe_room current_room
        end

    else if command is equal to "status" then
        call show_status

    else if command is equal to "inventory" or command is equal to "inv" or command is equal to "i" then
        call show_inventory

    # Movement commands
    else if command is equal to "north" or command is equal to "n" then
        if not current_room.north is equal to "" then
            set player.current_room to current_room.north
            set current_room to call get_room player.current_room
            set current_room.visited to true
            call describe_room current_room
        else
            print "You can't go that way."
            print ""
        end

    else if command is equal to "south" or command is equal to "s" then
        if not current_room.south is equal to "" then
            set player.current_room to current_room.south
            set current_room to call get_room player.current_room
            set current_room.visited to true
            call describe_room current_room
        else
            print "You can't go that way."
            print ""
        end

    else if command is equal to "east" or command is equal to "e" then
        if not current_room.east is equal to "" then
            set player.current_room to current_room.east
            set current_room to call get_room player.current_room
            set current_room.visited to true
            call describe_room current_room
        else
            print "You can't go that way."
            print ""
        end

    else if command is equal to "west" or command is equal to "w" then
        if not current_room.west is equal to "" then
            # Check if treasure room is locked
            if current_room.west is equal to "treasure_room" and treasure_room.locked then
                print "The treasure room is locked! You need all 3 gems."
                print ""
            else
                set player.current_room to current_room.west
                set current_room to call get_room player.current_room
                set current_room.visited to true
                call describe_room current_room
            end
        else
            print "You can't go that way."
            print ""
        end

    # Action commands (with lots of aliases!)
    else if command is equal to "pickup" or command is equal to "get" or command is equal to "take" or command is equal to "grab" or command contains "pick up" or command contains "get " or command contains "take " or command contains "grab " then
        call pickup_item current_room

    else if command is equal to "attack" or command is equal to "fight" or command is equal to "kill" or command contains "attack " or command contains "kill " then
        if game.combat_active then
            call combat_turn
        else if current_room.has_enemy then
            call start_combat current_room.enemy_name
        else if current_room.has_merchant then
            print "The merchant backs away nervously..."
            print "'Please! I'm just a humble merchant!'"
            print "'If you want my goods, you'll have to BUY them!'"
            print "(Maybe violence isn't always the answer...)"
            print ""
        else
            print "Nothing to attack!"
            print ""
        end

    else if command is equal to "use potion" or command is equal to "potion" or command is equal to "drink potion" or command is equal to "drink" or command contains "drink " then
        call use_potion

    else if command is equal to "wear armor" or command is equal to "equip armor" or command contains "wear " or command contains "equip " then
        if player.has_armor then
            print "You're already wearing the Chain Armor!"
            print ""
        else
            print "You don't have any armor to wear."
            print "Visit the merchant to buy some!"
            print ""
        end

    else if command is equal to "talk" or command contains "talk " then
        if current_room.has_merchant then
            call talk_to_merchant
        else
            print "Nobody to talk to."
            print ""
        end

    else if command contains "buy" then
        if current_room.has_merchant then
            if command contains "armor" then
                call buy_item "armor"
            else if command contains "potion" then
                call buy_item "potion"
            else if command contains "all" or command contains "everything" then
                # Buy everything the player can afford
                print "Buying everything you can afford..."
                print ""
                # Try to buy armor first (more expensive)
                if not player.has_armor and player.gold is above 29 then
                    call buy_item "armor"
                end
                # Then buy potions with remaining gold
                while player.gold is above 14 then
                    call buy_item "potion"
                end
                # Show final status
                if player.gold is below 15 then
                    print "That's all you can afford!"
                    print ""
                end
            else
                print "What do you want to buy? (armor, potion, or all)"
                print ""
            end
        else
            print "No merchant here!"
            print ""
        end

    else if command is equal to "help" or command is equal to "?" then
        print "MOVEMENT: north/n, south/s, east/e, west/w"
        print "LOOK AROUND: look/examine/inspect/l, ex (can examine items!)"
        print "INVENTORY: inventory/inv/i, status"
        print "ITEMS: get/take/pickup/grab (works with 'get sword' too!)"
        print "COMBAT: attack/fight/kill"
        print "HEALING: drink/use potion"
        print "EQUIPMENT: wear/equip armor"
        print "SHOPPING: talk, buy armor, buy potion, buy all"
        print "OTHER: help/?, quit/exit"
        print ""

    # Fun responses for silly commands
    else if command contains "tickle" then
        if current_room.has_merchant then
            print "The merchant giggles nervously."
            print "'Please sir, I'm trying to run a business here!'"
        else if current_room.has_enemy then
            print "That's... not a combat strategy."
        else
            print "You tickle the air. Nothing happens."
        end
        print ""

    else if command contains "dance" or command contains "sing" then
        print "Your {command} doesn't seem to help your situation."
        print "But points for creativity!"
        print ""

    else if command contains "sleep" or command contains "rest" then
        print "There's no time to rest! Adventure awaits!"
        print ""

    else if command contains "eat" and not command contains "potion" then
        print "You're not hungry right now."
        print "(Try 'drink potion' if you need healing)"
        print ""

    else if command contains "jump" then
        print "You jump up and down. Wheee!"
        print "(But it doesn't accomplish anything)"
        print ""

    else if command contains "yell" or command contains "shout" or command contains "scream" then
        if current_room.has_enemy then
            print "You yell loudly! The enemy seems unimpressed."
        else
            print "Your voice echoes through the dungeon."
        end
        print ""

    else
        print "Unknown command. Type 'help' for commands."
        print ""
    end
end

print ""
print "============================================"
print "Thanks for playing Dungeon Crawler!"
print "Built with Rosh v0.0.6"
print "============================================"
