# Stack manipulation commands

create x to 5
create y to 3

# Dup: duplicate top of stack
# Useful for reusing a value
get x
dup
multiply  # 5 * 5 = 25
print

# Swap: swap top two items
# Useful for reordering operands
get x
get y
swap
subtract  # After swap: 3 - 5 = -2
print

# Drop: remove top of stack
# Useful for discarding unwanted values
get x
get y
drop
get y
add  # 5 + 3 = 8
print

# Complex example: (x + y) * x = (5 + 3) * 5 = 40
get x
get y
add    # Stack: [8]
get x  # Stack: [8, 5]
multiply
print  # Should be 40
