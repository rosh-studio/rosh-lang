# Example: Adding a Room Live to the MUD
# Run this after loading mud-game.rosh to see live world expansion!

print "=== Adding a new room: The Library ==="

# 1. Create the room object
create object library
  set name to "Grand Library"
  set description to "Towering bookshelves line every wall. The scent of old parchment fills the air. A reading desk sits by the window."
  set north to "courtyard"
  set south to null
  set east to null
  set west to null
end

# 2. Connect it to courtyard (make courtyard's south exit lead to library)
set courtyard.south to "library"

# 3. Update shop's connection (library is south of courtyard, shop is south of library)
set library.south to "shop"
set shop.north to "library"

print "Library added!"
print ""
print "Try:"
print "  set player.current-room to \"library\""
print "  call look"
print ""
print "Or create an alias:"
print "  alias lib set player.current-room to \"library\""
print "  lib"
print "  look"
